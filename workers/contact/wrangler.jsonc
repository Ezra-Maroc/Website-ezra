// Fonction Cloudflare du formulaire de contact (voir README.md). Deploiement : npm run deploy (dans ce dossier).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezra-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "FROM_ADDRESS": "formulaire@form.ezra-maroc.com",
    "TO_ADDRESS": "info@ezra-project.fr",
    // jetons Turnstile acceptes seulement s'ils ont ete obtenus sur ces domaines
    "TURNSTILE_HOSTNAMES": "ezra-maroc.com,www.ezra-maroc.com"
  },
  // Secret a definir une fois : npx wrangler secret put TURNSTILE_SECRET
  "send_email": [
    {
      "name": "EMAIL",
      // la fonction ne peut ecrire qu'a cette adresse, et seulement depuis l'expediteur ci-dessous
      "destination_address": "info@ezra-project.fr",
      "allowed_sender_addresses": ["formulaire@form.ezra-maroc.com"]
    }
  ]
}
