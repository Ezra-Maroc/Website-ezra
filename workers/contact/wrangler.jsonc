// Fonction Cloudflare du formulaire de contact (voir README.md). Deploiement : npm run deploy (dans ce dossier).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // "ezra-contact" existe deja dans le compte (ancien essai, non utilise par le site) : nom distinct pour ne pas l'ecraser
  "name": "ezra-formulaire",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Expediteur sur a2deepsec.com (domaine du compte sans messagerie) : Email Routing n'y casse rien, alors
    // qu'ezra-maroc.com garde ses MX historiques (ancienne messagerie, action@ezra-maroc.com).
    "FROM_ADDRESS": "formulaire@a2deepsec.com",
    "TO_ADDRESS": "info@ezra-project.fr",
    // jetons Turnstile acceptes seulement s'ils ont ete obtenus sur ces domaines
    "TURNSTILE_HOSTNAMES": "ezra-maroc.com,www.ezra-maroc.com",
    // Questionnaire approfondi (src/intake/) : cle PUBLIQUE du logiciel EZRA (RSA-OAEP 3072, SPKI base64).
    // Elle ne permet que de chiffrer ; la cle privee reste sur le PC (webapp/services/intake_service.py).
    "INTAKE_PUBLIC_KEY": "",
    // "full" = recapitulatif complet par e-mail ; "notify" = simple avis sans donnee personnelle
    "INTAKE_EMAIL_MODE": "full",
    "INTAKE_FROM_NAME": "Questionnaire Ezra Maroc"
  },
  // Secrets a definir une fois : npx wrangler secret put TURNSTILE_SECRET / INTAKE_MASTER_KEY
  // Questionnaire : etat des liens + copies chiffrees en attente du logiciel (migrations/)
  "d1_databases": [
    { "binding": "INTAKE_DB", "database_name": "ezra-intake", "database_id": "f34e4c61-2524-4d0d-8b1a-9005f0d654ff", "migrations_dir": "migrations" }
  ],
  // Limite par adresse IP sur /intake/login, /intake/verify et /intake/submit (en plus de Turnstile et du blocage
  // a 5 mots de passe faux)
  "ratelimits": [
    { "name": "INTAKE_LIMITER", "namespace_id": "1101", "simple": { "limit": 20, "period": 60 } }
  ],
  // Menage quotidien (03:17 UTC) : copies chiffrees > 60 jours, liens expires depuis > 90 jours
  "triggers": { "crons": ["17 3 * * *"] },
  "send_email": [
    {
      "name": "EMAIL",
      // la fonction ne peut ecrire qu'a cette adresse, et seulement depuis l'expediteur ci-dessous
      "destination_address": "info@ezra-project.fr",
      "allowed_sender_addresses": ["formulaire@a2deepsec.com"]
    }
  ]
}
