// Fonction Cloudflare du formulaire de contact (voir README.md). Deploiement : npm run deploy (dans ce dossier).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // "ezra-contact" existe deja dans le compte (ancien essai, non utilise par le site) : nom distinct pour ne pas l'ecraser
  "name": "ezra-formulaire",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // Expediteur sur a2deepsec.com (domaine du compte sans messagerie) : Email Routing n'y casse rien, alors
    // qu'ezra-maroc.com garde ses MX historiques (ancienne messagerie, action@ezra-maroc.com).
    "FROM_ADDRESS": "formulaire@a2deepsec.com",
    "TO_ADDRESS": "info@ezra-project.fr",
    // jetons Turnstile acceptes seulement s'ils ont ete obtenus sur ces domaines
    "TURNSTILE_HOSTNAMES": "ezra-maroc.com,www.ezra-maroc.com"
  },
  // Secret a definir une fois : npx wrangler secret put TURNSTILE_SECRET
  "send_email": [
    {
      "name": "EMAIL",
      // la fonction ne peut ecrire qu'a cette adresse, et seulement depuis l'expediteur ci-dessous
      "destination_address": "info@ezra-project.fr",
      "allowed_sender_addresses": ["formulaire@a2deepsec.com"]
    }
  ]
}
