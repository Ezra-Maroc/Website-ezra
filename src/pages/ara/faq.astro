---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const lang = 'ar' as const;

const faqJsonLD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "من يمكنه الحصول على الجنسية المغربية؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "أي شخص يمكنه إثبات صلة نسب مع مواطن مغربي قد يكون مؤهلاً للحصول على الجنسية المغربية."
      }
    },
    {
      "@type": "Question",
      "name": "ما هي الوثائق المطلوبة؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تشمل الوثائق الرئيسية: شهادة الميلاد، بطاقة الهوية، شهادة ميلاد الوالد المغربي، وأي وثيقة تثبت صلة النسب."
      }
    },
    {
      "@type": "Question",
      "name": "كم يستغرق الإجراء؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "تختلف المدة حسب تعقيد الملف، عادة ما بين 6 أشهر وسنتين."
      }
    },
    {
      "@type": "Question",
      "name": "هل يمكن لعزرا ماروك مساعدتي إذا كنت أعيش في الخارج؟",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "نعم، نرافق العملاء من جميع أنحاء العالم في إجراءات الحصول على الجنسية المغربية."
      }
    }
  ]
};
---

<BaseLayout
  lang={lang}
  title="أسئلة شائعة - الجنسية المغربية | عزرا ماروك"
  description="لقاو أجوبة على الأسئلة الشائعة حول الحصول على الجنسية المغربية عبر عزرا ماروك. الأهلية، المسار، الوثائق، الجنسية المزدوجة، والمزيد."
  currentPage="faq"
  pageCSS={['faq']}
  jsonLD={faqJsonLD}
>
    <main id="main-content" class="page-banner">
        <div class="container">
            <h1>أسئلة شائعة (FAQ)</h1>
            <p>لقاو هنا أجوبة على الأسئلة لي كتعاود بزاف على الحصول على الجنسية المغربية.</p>
        </div>
    </main>

    <section class="section advantages-section-servicelike">
        <div class="container">
            <h2 class="section-title">علاش تحصل على الجنسية المغربية؟ <span>المزايا الرئيسية</span></h2>
            <div class="advantages-grid-sl">
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-house-user" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">حق الإقامة غير المحدود</h3> <p>تسكن، تخدم، وتتحرك بحرية فالمغرب بلا بطاقة إقامة.</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-vote-yea" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">حقوق مدنية وسياسية</h3> <p>تشارك بشكل كامل فالحياة العامة (التصويت، الترشح).</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">ولوج للتشغيل</h3> <p>ولوج مفتوح لمعظم الوظائف (قيود على مناصب حساسة).</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-leaf" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">حقوق ملكية موسعة</h3> <p>إمكانية شراء جميع أنواع العقارات، بما فيها الأراضي الفلاحية.</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-children" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">نقل أسهل</h3> <p>الجنسية كتنتقل عموما لولادك.</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-passport" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">سفر مسهل</h3> <p>الجواز كيعطي ولوج أسهل (تقريبا 85 دولة، المرتبة ~60 عالميا).</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">حماية قنصلية</h3> <p>مساعدة من السفارات/القنصليات فالخارج.</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-landmark-flag" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">إعادة تواصل ثقافي</h3> <p>ترسيم وتقوية روابطك مع التراث المغربي.</p> </div>
                <div class="advantage-card-sl"> <div class="advantage-icon-sl"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></div> <h3 class="advantage-title-sl">ولوج للخدمات الاجتماعية</h3> <p>ولوج محتمل لأنظمة التعليم، الرعاية الصحية، إلخ.</p> </div>
            </div>
        </div>
    </section>

    <div class="faq-container">

        <section class="faq-section">
            <h2>الجنسية المغربية: أكتر بزاااف من مجرد وضع قانوني</h2>
            <p> الجنسية المغربية ماشي غير مجرد إجراء قانوني بسيط. هي كتمثل رابط عميق بين الشخص والمغرب، متجذر فالتاريخ، الثقافة، والذاكرة العائلية. هي طريقة للاعتراف الرسمي بالانتماء لي كيمتد عبر الأجيال، حتى من ورا الحدود أو الهجرات. </p>
            <p> طلب أو استرجاع الجنسية المغربية، خصوصا عن طريق النسب، غالبا كيكون فعل هوياتي قوي. كيسمح للأفراد بإعادة التواصل مع أصولهم، يخليو الروابط ديالهم الشخصية والعائلية مع المملكة معترف بها، ويشاركو بشكل كامل فالمجتمع الوطني. </p>
            <p> ولكن، الإجراءات الإدارية تقدر تكون معقدة، خصوصا ملي كيتعلق الأمر بإثبات النسب مع جد مغربي. هادشي علاش درنا هاد الأسئلة الشائعة: باش نوجهوكم بوضوح ومنهجية فهاد المسار. هي موجهة بالأساس للناس لي والديهم أو جدودهم من أصل مغربي وباغين يحصلو على الجنسية على هاد الأساس. </p>
            <p> الفريق ديالنا كيجمع بين الخبرة القانونية الدقيقة والفهم الإنساني للمسارات الفردية. حنا ماشي غير كنخدمو الملفات: كنرافقو قصص، كنعاودو نربطو الصلات، وكنعاونو كل واحد يرسخ التراث ديالو فاعتراف قانوني. </p>
            <p> كنشجعوكم تبداو هاد الرحلة ديال إعادة التواصل الهوياتي، معتمدين على دعمنا الصارم، المحترم، والمهتم جدا بغنى المسارات الشخصية. </p>
        </section>

        <section class="faq-section">
            <h2>أسئلة عامة حول الجنسية المغربية</h2>
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-qg1">
                    <span>شكون يقدر يطالب بالجنسية المغربية؟</span>
                    <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-qg1" aria-hidden="true">
                    <p>الجنسية المغربية كينظمها أساسا قانون الجنسية المغربي. الطرق الرئيسية باش تاخدها هي:</p>
                    <ul> <li><strong>بالنسب (البنوة):</strong> تكون تزاديتي من أب مغربي أو أم مغربية. هادي هي الطريق الأكثر شيوعا للجالية والمجال الرئيسي ديال الخبرة ديالنا. <em>(ملاحظة: بالنسبة للناس لي تزادو من أم مغربية قبل 2007، غالبا كيكون ضروري تصريح خاص.)</em></li> <li><strong>بالولادة فالمغرب (حق الأرض):</strong> فحالات جد محددة (مثلا، والدين مجهولين، والدين أجانب تزادو هوما نيت فالمغرب بشروط معينة، شباب مقيمين بشكل نظامي...).</li> <li><strong>بالزواج:</strong> لأجنبي مزوج بمغربي(ة) بعد 5 سنين ديال الزواج وسكن مستقر ومستمر فالمغرب.</li> <li><strong>بالتجنيس:</strong> قرار من الدولة كيمنح لأجنبي كيستوفي شروط معينة (إقامة طويلة، اندماج، إلخ.).</li> </ul>
                    <p>كل حالة فريدة وكتطلب تحليل فردي.</p>
                </div>
            </div>
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-qg2">
                   <span>واش نقدر نحتافظ بجنسيتي الحالية (الجنسية المزدوجة)؟</span>
                   <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-qg2" aria-hidden="true">
                     <p>نعم، المغرب كيسمح بالجنسية المزدوجة. عموما ماخاصكش تتخلى على جنسيتك الأخرى باش تاخد الجنسية المغربية.</p>
                     <p>مهم تعرف أنه ملي كتكون فالتراب المغربي، السلطات المغربية كتعتابرك أولا كمغربي. هادشي كيعني أن القوانين المغربية هي لي كتطبق أولا، والمساعدة القنصلية من بلدك الآخر تقدر تكون محدودة فبعض الحالات.</p>
                 </div>
            </div>
             <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-qg3">
                   <span>شنو هي الوثائق المطلوبة عموما؟</span>
                    <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-qg3" aria-hidden="true">
                     <p> الوثائق المحددة ديما كتعتامد على وضعيتك الشخصية والأساس لي كتقدم عليه طلب الجنسية (نسب أبوي، نسب أمومي، تاريخ الولادة، إلخ). </p> <p> عادة، غاتحتاج تقدم نسخ كاملة وحديثة من عقود الحالة المدنية (ديالك، ديال والديك/جدودك المغاربة) باش تثبت الروابط العائلية بشكل قاطع. </p> <p> الإثبات الحاسم كيتعلق بالجنسية المغربية ديال جدودك فوقت الانتقال المعني (ولادتك، ولادة والدك...). هادشي يقدر يكون نسخة من بطاقتهم الوطنية للتعريف الإلكترونية (CNIE)، شهادة جنسية قديمة، أو وثائق مغربية رسمية وقاطعة أخرى. </p> <p> إثبات الخط المباشر للنسب يقدر يكون معقد، خصوصا على مدى أجيال متعددة، وغالبا كيطلب بحث معمق فسجلات الحالة المدنية (العدول، ضباط الحالة المدنية) أو الأرشيف القنصلي المغربي. </p> <p> تذكر أن الوثائق الصادرة من سلطات أجنبية عموما خاصها تترجم للعربية من طرف مترجم محلف لدى المحاكم المغربية. غالبا كتحتاج أيضا المصادقة أو الأبوستيل (حسب الاتفاقيات الدولية) باش يتعترف بها فالمغرب. </p> <p> عزرا ماروك كتعاونك تحدد اللائحة الدقيقة للوثائق اللازمة للحالة <em>الخاصة بك</em> وكتساعدك فعمليات الجمع، الترجمة، والمصادقة/الأبوستيل. </p>
                 </div>
            </div>
             <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-qg4">
                    <span>واش خاصني نكون كنهضر بالعربية أو الأمازيغية باش ناخد الجنسية بالنسب؟</span>
                     <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-qg4" aria-hidden="true">
                    <p>لا، معرفة اللغة (الدارجة، العربية الفصحى، أو الأمازيغية) ماشي شرط قانوني باش تحصل على الجنسية المغربية بالنسب (حق الدم).</p>
                    <p>هاد الشرط ديال اللغة كيهم أساسا مسطرة التجنيس، فين كيتقيم الاندماج فالمجتمع المغربي.</p>
                </div>
            </div>
        </section>

        <section class="faq-section">
            <h2>الإجراءات والآجال</h2>
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-proc1">
                    <span>شنو هي المسطرة المعتادة؟</span>
                     <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-proc1" aria-hidden="true">
                    <p>المسطرة العامة كتضمن تجميع دقيق لملف فيه كاع الإثباتات المطلوبة (الحالة المدنية، إثبات جنسية الجد، إثبات النسب).</p> <p>هاد الملف كيتقدم للسلطة المختصة: غالبا المحكمة الابتدائية (قسم الجنسية) فالمغرب، أو أحيانا عبر القنصلية المغربية فمحل إقامتك.</p> <p>كتبعها مرحلة تحقيق، فين كيتم التحقق من الوثائق من طرف وكيل الملك والقاضي المكلف بالجنسية. يقدر يتطلب تحقيقات إضافية.</p> <p>المسطرة كتسالي بقرار رسمي: إما تسليم مباشر لشهادة الجنسية المغربية (CNM) أو حكم تصريحي بالجنسية صادر عن المحكمة.</p> <p>كنوجهوكم فكل خطوة، من جمع الأدلة حتى التقديم والمتابعة، باش نضمنو المطابقة ونزيدو من فرص نجاح طلبكم.</p>
                </div>
             </div>
            <div class="faq-item">
                <button class="faq-question" aria-expanded="false" aria-controls="faq-proc2">
                   <span>شحال كتاخد العملية ديال الوقت؟</span>
                    <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                </button>
                <div class="faq-answer" id="faq-proc2" aria-hidden="true">
                     <p>الآجال كتختلف <strong>بزاف</strong> حسب تعقيد الملف، عبء العمل ديال الإدارات المعنية (المحاكم، القنصليات)، والحاجة لتحقيقات أو تدقيقات محتملة. <strong>ماكاينش أجل قانوني أو تنظيمي مضمون</strong> فالقانون المغربي للبت فطلب الجنسية.</p> <p>فقط بناءً على تجربتنا ولأغراض إرشادية:</p> <ul> <li><strong>النسب (حالات بسيطة، موثقة جيدا):</strong> أجل من 6 أشهر لسنتين كيتلاحظ أحيانا، ولكن هاد المجال كيبقى متفائل وغير مضمون.</li> <li><strong>النسب (حالات معقدة):</strong> الملفات لي كتطلب بحث واسع (أرشيف قديم، أدلة غير مباشرة)، كتشمل أجيال متعددة، أو فيها تعقيدات إدارية (وثائق ناقصة، نسخ) <strong>تقدر تفوت بسهولة 3 سنين، أو حتى أكتر</strong>.</li> <li><strong>الزواج / التجنيس:</strong> هاد العمليات عموما أطول وكتعتامد بصرامة على استيفاء الشروط القانونية (مدة الإقامة الفعلية، إلخ.).</li> </ul> <p>الدور ديالنا هو نحضرو الملف الأكثر اكتمالا وحجة ممكن باش نحاولو نحسنو هاد الآجال، ونضمنو متابعة منتظمة مع السلطات، ولكن الإدارة كتبقى صاحبة السيادة بخصوص سرعة المعالجة ديالها.</p>
                </div>
             </div>
             <div class="faq-item">
                 <button class="faq-question" aria-expanded="false" aria-controls="faq-proc3">
                     <span>واش يمكن تتبع الطلب؟ واش كاين طعون؟</span>
                     <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                 </button>
                 <div class="faq-answer" id="faq-proc3" aria-hidden="true">
                    <p> نعم، التتبع ممكن، وخا كيطلب منهجية ومثابرة. ضروري تحتفظو بعناية بنسخة كاملة من ملفكم لي تقدمتو به وكذلك بوصل الإيداع الرسمي، لي غالبا كيكون فيه رقم مرجعي. </p> <p> المتابعة المنتظمة مع الإدارة المختصة (كتابة الضبط فالمحكمة، المصلحة القنصلية) مستحسنة باش تستفسرو على التقدم. ولكن، عرفو أن الأجوبة تقدر تكون موجزة وأوقات المعالجة أحيانا طويلة. </p> <p> ف حالة قرار رفض صريح (أو أحيانا ضمني بعد صمت طويل)، ماتفقدوش الأمل. كاين طرق للطعن (استئناف، طعن بالنقض حسب الحالة) باش تعارضو القرار قدام محاكم أعلى درجة. </p> <p> الفريق القانوني ديالنا عندو خبرة فهاد الإجراءات القضائية ويقدر ينصحكم حول جدوى الطعن، ويعاونكم فتحضيرو وتقديمه إذا لزم الأمر. </p>
                 </div>
              </div>
               <div class="faq-item">
                   <button class="faq-question" aria-expanded="false" aria-controls="faq-proc4">
                       <span>واش السفر للمغرب ديما ضروري؟</span>
                       <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                   </button>
                   <div class="faq-answer" id="faq-proc4" aria-hidden="true">
                      <p> الحاجة للسفر جسديا للمغرب كتعتامد على موقعكم الجغرافي، القنصلية لي تابعين ليها، والطبيعة الدقيقة للمسطرة ديالكم. ماشي ديما منهجي ولكن كيبقى شائع. </p> <p> <strong>لوثائق الهوية (البطاقة الوطنية CNIE، الجواز):</strong> ملي كتحصلو على الجنسية وتثبتوها (بشهادة الجنسية CNM أو حكم منسوخ)، السفر غالبا كيكون مطلوب لتقديم الطلب واستلام هاد الوثائق. ولكن، بعض القنصليات الكبيرة (مثلا، باريس، مدريد، مونتريال، نيويورك، إلخ) ولات مجهزة دابا باش تاخد البيانات البيومترية. تحققو مع القنصلية ديالكم واش كتقدم هاد الخدمة. </p> <p> <strong>للمسطرة القضائية (إذا كانت منطبقة):</strong> إذا كانت قضيتكم كتطلب الحضور قدام قاضي (مثلا، لحكم تصريحي بالجنسية)، بعض الخطوات أو الجلسات <em>تقدر أحيانا</em> تفوض من طرف القاضي المغربي للقنصلية عبر "إنابة قضائية". ولكن، هادشي كيعتامد على قرار القاضي وطبيعة الإجراء المطلوب. الحضور الشخصي فالمغرب يقدر إذن يبقى ضروري فبعض القضايا القضائية. </p> <p> <strong>الخلاصة:</strong> الحضور الجسدي يقدر يكون مطلوب فمراحل مختلفة. تقييم شخصي لملفكم من طرفنا غايعاون توقعو بشكل أفضل أي سفر ضروري فحالكم الخاصة. </p>
                   </div>
               </div>
        </section>

        <section class="faq-section">
             <h2>حالات خاصة</h2>
            <div class="faq-item">
                  <button class="faq-question" aria-expanded="false" aria-controls="faq-cas1">
                      <span>ماذا عن أحفاد اليهود المغاربة؟</span>
                      <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                  </button>
                 <div class="faq-answer" id="faq-cas1" aria-hidden="true">
                    <p> تماما. المواطنين المغاربة من الديانة اليهودية والأحفاد ديالهم يقدرو يطالبو بالجنسية المغربية بالنسب، بنفس الشروط ديال أي مغربي آخر، طبقا لقانون الجنسية. دستور 2011 المغربي كيعترف بشكل صريح بالرافد العبري كواحد من مكونات الهوية الوطنية الموحدة. </p> <p> التحدي الرئيسي، كيفما فبزاف ديال طلبات النسب لي كتخص العائلات لي هاجرات شحال هادي، غالبا كيكون فجمع الأدلة الوثائقية. خاص يكون ممكن نثبتو بشكل قاطع الخط المباشر للنسب من الجد المغربي (الأب أو الأم حسب الحالة والعصر) والاحتفاظ ديالو بالجنسية المغربية (أنه مفقدهاش أو تخلى عليها طوعا قبل الانتقال). </p> <p> البحث على وثائق قديمة (عقود الحالة المدنية العبرية أو المدنية، وثائق السفر، سجلات قنصلية، إثباتات إقامة...) يقدر يكون معقد. عزرا ماروك طورات خبرة خاصة فهاد المجال، بما فيها البحث فأرشيفات متنوعة والتجميع الدقيق لهاد الملفات باش تلبي المتطلبات القانونية. </p>
                 </div>
             </div>
             <div class="faq-item">
                 <button class="faq-question" aria-expanded="false" aria-controls="faq-cas2">
                     <span>كيفاش القاصرين كيحصلو على الجنسية؟</span>
                     <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                  </button>
                 <div class="faq-answer" id="faq-cas2" aria-hidden="true">
                     <p> بالنسبة لطفل قاصر، الحصول على الجنسية المغربية كيعتامد أساسا على جنسية الوالدين فوقت الولادة والتشريع لي كان ساري المفعول فهاديك الفترة. </p> <p> حسب قانون الجنسية الحالي (من بعد تعديل 2007)، الطفل لي تزاد من أب مغربي أو أم مغربية هو مغربي. الانتقال عن طريق الأم إذن مكافئ للانتقال عن طريق الأب. الحصول عموما كيكون تلقائي بحكم القانون ولكن كيطلب التسجيل فالحالة المدنية المغربية باش يكون فعال. </p> <p> ملاحظة: للأطفال لي تزادو من أم مغربية وأب أجنبي <em>قبل</em> تعديل 2007، الجنسية ماكانتش تلقائية. كاين مساطر خاصة للتصريح أو الطلب من طرف الأم أو الطفل ملي يوصل سن الرشد باش يتعترف بهاد الجنسية (المادة 6 من القانون). </p> <p> مهم نلاحظو أن <em>الكفالة</em> (الولاية القانونية فالقانون المغربي والإسلامي، لي ماشي تبني تام كيقطع النسب الأصلي) ماكتعطيش تلقائيا الجنسية المغربية للطفل المكفول. شروط إقامة محددة ومسطرة متميزة منصوص عليها للتجنيس المحتمل للطفل المكفول. </p>
                 </div>
             </div>
         </section>

         <section class="faq-section">
              <h2>الفقدان والاسترجاع</h2>
              <div class="faq-item">
                  <button class="faq-question" aria-expanded="false" aria-controls="faq-perte1">
                    <span>واش يمكن تفقد الجنسية المغربية؟</span>
                    <i class="fas fa-chevron-down faq-icon" aria-hidden="true"></i>
                  </button>
                  <div class="faq-answer" id="faq-perte1" aria-hidden="true">
                     <p> فقدان الجنسية المغربية <strong>بشكل غير إرادي</strong> نادر جدا ومنظم بصرامة بالقانون. يقدر يوقع فقط فحالات محددة منصوص عليها فقانون الجنسية (مثلا، اكتساب طوعي لجنسية أجنبية مع طلب صريح لفقدان الجنسية المغربية قبل تواريخ معينة، شغل منصب عمومي لدولة أجنبية بلا ترخيص، أفعال خطيرة ضد أمن الدولة...). </p>
                     <p> ممكن تطلب <strong>طوعا</strong> التخلي عن الجنسية المغربية (فعل التجريد)، مثلا، إذا كانت جنسية أخرى كتشترطو. ولكن، هاد التخلي ماشي أبدا تلقائي. كيطلب ترخيص صريح كيمنح بمرسوم من الحكومة المغربية، لي كتدرس الطلب كل حالة بوحدها وتقدر ترفضو. </p>
                     <p> بالنسبة للناس لي يمكن يكونو فقدو الجنسية المغربية فالماضي (مثلا، بسبب قوانين قديمة على الزواج أو الإقامة فالخارج)، كاين مساطر لـ <strong>الاسترجاع</strong> للجنسية المغربية منصوص عليها فالقانون، بشرط استيفاء شروط معينة (خصوصا إثبات الإقامة الاعتيادية فالمغرب). </p>
                  </div>
             </div>
         </section>

