---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const lang = 'ar' as const;
---

<BaseLayout
  lang={lang}
  title="قصتنا والتزامنا | عزرا ماروك"
  description="اكتشفوا شكون حنا، شغفنا فإعادة ربط الأفراد بتراثهم، والقيم اللي كتوجه التزامنا معاكم."
  currentPage="about"
  canonicalPath="/ara/about.html"
  pageCSS={['a-propos']}
>
    <main id="main-content" class="page-banner">
        <div class="container">
            <h1>قصتنا، جسركم للمغرب</h1>
            <p>اكتشفوا شكون حنا، شغفنا فإعادة ربط الأفراد بتراثهم، والقيم اللي كتوجه التزامنا معاكم.</p>
        </div>
    </main>

    <section id="histoire" class="section about-section">
        <div class="container">
            <h2 class="section-title internal-title">في جذور <span>عزرا ماروك</span></h2>
            <div class="about-content">
                <div class="about-image">
                    <picture>
                    <source srcset="../img/logo.webp" type="image/webp">
                    <img src="../img/logo.png" alt="لوغو عزرا ماروك" width="751" height="721">
                </picture>
                </div>
                <div class="about-text">
                    <p>تأسست <strong>عزرا ماروك</strong> بمهمة واضحة، جات من الملاحظة المباشرة للتحديات لي كيواجهوها الناس لي باغين يرجعو يتواصلو مع جذورهم المغربية. شفنا الإحباط من الإجراءات الإدارية المعقدة، لي غالبا كتبان بحال شي متاهة صعيبة.</p>
                    <p>خصوصا بالنسبة للمهاجرين و ولادهم، لي روابطهم بالمغرب كتمتد لأجيال وقارات، الحصول على الجنسية كيمثل كتر من مجرد إجراء إداري: هو <strong>تأكيد للهوية</strong>، و<strong>جسر للتراث الثقافي</strong>. عزرا ماروك تدارت باش تحول هاد الطريق الصعيبة لمسار ساهل ومريح.</p>
                    <blockquote class="about-quote">
                         "تبسيط الحصول على الجنسية المغربية هي خدمتنا وشغفنا."
                    </blockquote>
                </div>
            </div>
        </div>
    </section>

    <section id="mission" class="section mission-section alt-bg">
        <div class="container">
            <h2 class="section-title">مهمتنا <span>الأساسية</span></h2>
            <div class="mission-content">
                <p class="mission-statement">نكونو شريككم الخبير والمهتم لتحويل التعقيدات الإدارية إلى مسار واضح نحو جنسيتكم المغربية.</p>
                <div class="mission-commitments">
                    <h3>التزاماتنا الملموسة:</h3>
                    <ul class="commitment-list">
                        <li><i class="fa-solid fa-check" aria-hidden="true"></i> <strong>تسهيل الولوج</strong>: نزيل العقبات أمام كل من له الحق الشرعي في الجنسية.</li>
                        <li><i class="fa-solid fa-check" aria-hidden="true"></i> <strong>تثمين الروابط</strong>: نعترف بالروابط التاريخية والثقافية مع المغرب ونعززها.</li>
                        <li><i class="fa-solid fa-check" aria-hidden="true"></i> <strong>الخدمة بامتياز</strong>: نقدم خبرة قانونية متقدمة ودعمًا إنسانيًا من الدرجة الأولى.</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <section id="equipe" class="section team-section">
        <div class="container">
            <h2 class="section-title">فريق <span>خبرائنا</span></h2>
            <p class="team-intro">تكامل للمهارات مخصص لمشروعكم، يجمع بين الخبرة القانونية والمعرفة الإدارية والالتزام الإنساني.</p>
            <div class="team-grid">
                <div class="team-category">
                    <div class="category-icon"><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i></div>
                    <h3>خبراء قانونيون</h3>
                    <p>متمكنون من قانون الجنسية، يبنون استراتيجية ملفكم.</p>
                </div>
                <div class="team-category">
                    <div class="category-icon"><i class="fa-solid fa-landmark" aria-hidden="true"></i></div>
                    <h3>متخصصون إداريون</h3>
                    <p>إداريون سابقون، يعرفون دواليب الإدارة من الداخل.</p>
                </div>
                <div class="team-category">
                    <div class="category-icon"><i class="fa-solid fa-file-signature" aria-hidden="true"></i></div>
                    <h3>مستشارو العملاء</h3>
                    <p>الشخص المخصص لكم، يضمن متابعة شخصية.</p>
                </div>
                <div class="team-category">
                    <div class="category-icon"><i class="fa-solid fa-tree" aria-hidden="true"></i></div>
                    <h3>خبراء الأنساب</h3>
                    <p>نتحرك للعثور على الأدلة والوثائق الأساسية.</p>
                </div>
                <div class="team-category">
                    <div class="category-icon"><i class="fa-solid fa-language" aria-hidden="true"></i></div>
                    <h3>مترجمون محلفون</h3>
                    <p>يضمنون المطابقة اللغوية لوثائقكم الرسمية.</p>
                </div>
            </div>
            <p class="team-commitment">قوتنا الجماعية: شغف مشترك بإعادة ربط الأفراد بتاريخهم المغربي.</p>
        </div>
    </section>

    <section id="methodologie" class="section methodology-section alt-bg">
        <div class="container">
            <h2 class="section-title">منهجيتنا <span>المجربة</span></h2>
            <p class="methodology-intro">نهج <strong>"مشروع عزرا ماروك"</strong> يجمع بين الدقة والمرونة لزيادة فرص نجاحكم إلى أقصى حد:</p>
            <div class="methodology-pillars">
                <div class="pillar">
                    <div class="pillar-icon"><i class="fa-solid fa-gavel" aria-hidden="true"></i></div>
                    <h3>تحليل قانوني</h3>
                    <p>تشخيص دقيق لأهليتكم واستراتيجية مخصصة.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon"><i class="fa-solid fa-building-columns" aria-hidden="true"></i></div>
                    <h3>إجراءات إدارية</h3>
                    <p>جمع وإعداد دقيق لكل جزء من الملف.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon"><i class="fa-solid fa-user-tie" aria-hidden="true"></i></div>
                    <h3>مواكبة</h3>
                    <p>مسؤول اتصال مخصص يوجهكم ويبلغكم.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon"><i class="fa-solid fa-rocket" aria-hidden="true"></i></div>
                    <h3>إدارة استباقية</h3>
                    <p>توقع وحل سريع للعقبات المحتملة.</p>
                </div>
                <div class="pillar">
                    <div class="pillar-icon"><i class="fa-solid fa-handshake" aria-hidden="true"></i></div>
                    <h3>شبكة محلية نشطة</h3>
                    <p>شركاؤنا في المغرب يسهلون الإجراءات على الأرض.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="valeurs" class="section values-section">
        <div class="container">
            <h2 class="section-title"><span>قيمنا</span></h2>
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon"><i class="fa-solid fa-trophy" aria-hidden="true"></i></div>
                    <h3>الامتياز</h3>
                    <p>نسعى للكمال في كل ملف، بخبرة مصقولة باستمرار وجودة خدمة لا تشوبها شائبة.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon"><i class="fa-solid fa-glasses" aria-hidden="true"></i></div>
                    <h3>الشفافية</h3>
                    <p>التواصل المفتوح والصادق يضمن لكم رؤية كاملة لتقدم طلبكم.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
                    <h3>النزاهة</h3>
                    <p>نعمل بأخلاقيات صارمة، مع ضمان الامتثال القانوني وسرية ملفكم.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon"><i class="fa-solid fa-heart" aria-hidden="true"></i></div>
                    <h3>التعاطف</h3>
                    <p>نفهم الأهمية الشخصية لمشروعكم ونقدم دعمًا محترمًا ومنصتًا.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="engagement" class="section engagement-section alt-bg">
        <div class="container">
            <h2 class="section-title">التزامنا: <span>نجاحكم</span></h2>
            <div class="engagement-content">
                <p>في عزرا ماروك، الحصول على شهادة جنسيتكم ليس النهاية؛ إنها بداية فصل جديد. نحن نستثمر في نجاحكم لأن إعادة تواصلكم مع جذوركم هو أيضًا أعظم مكافأة لنا.</p>
                <p>ثقوا بفريق يتعامل مع مشروعكم بالجدية والاهتمام الذي يستحقه، محولين طموحكم إلى حقيقة ملموسة.</p>
            </div>
            <div class="engagement-actions">
                <a href="services.html" class="btn btn-primary">اكتشفوا خدماتنا بالتفصيل</a>
                <a href="contact.html" class="btn btn-outline">تحدثوا مع مستشار</a>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2 class="cta-title">مستعدون لاتخاذ الخطوة الأولى نحو جنسيتكم المغربية؟</h2>
            <div class="cta-buttons">
                <a href="contact.html#contact-form-container" class="btn btn-light">طلب تقييم مجاني</a>
                <a href="faq.html" class="btn btn-outline-light">شاهدوا الأسئلة الشائعة</a>
            </div>
        </div>
    </section>
  <CtaBanner lang={lang} />
</BaseLayout>
