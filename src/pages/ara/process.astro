---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const lang = 'ar' as const;
---

<BaseLayout
  lang={lang}
  title="مسارنا الواضح والمنظم | عزرا ماروك"
  description="اكتشفو منهجية عزرا ماروك المنظمة، المصممة لتوجيهكم بسلاسة وفعالية نحو الحصول على جنسيتكم المغربية."
  currentPage="process"
  pageCSS={['processus']}
>
  <main id="main-content" class="page-banner">
    <div class="container">
      <h1>مسارنا المُجرب</h1>
      <p>اكتشفو منهجيتنا المنظمة، المصممة لتوجيهكم بسلاسة وفعالية نحو الحصول على جنسيتكم المغربية.</p>
    </div>
  </main>

  <section class="section overview-section">
    <div class="container">
      <h2 class="section-title">رحلتكم المبسطة: <span>نظرة عامة</span></h2>
      <p class="overview-text">قسمنا الطريق نحو الجنسية لخطوات واضحة ومتميزة. كل مرحلة مصممة باش تتقدم بشكل منهجي، بأهداف محددة وشفافية تامة، باش تزيد من فرص نجاحكم لأقصى حد.</p>
      <div class="process-timeline">
        <div class="timeline-item">
          <div class="timeline-number">0</div>
          <div class="timeline-content">
            <h3>التشخيص الأولي</h3>
            <span class="timeline-duration">1-3 أسابيع</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">1</div>
          <div class="timeline-content">
            <h3>تكوين الملف</h3>
            <span class="timeline-duration">1-4 أشهر</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">2</div>
          <div class="timeline-content">
            <h3>التقديم والمتابعة الأولية</h3>
            <span class="timeline-duration">2-3 أشهر</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">3</div>
          <div class="timeline-content">
            <h3>الدراسة والقرار</h3>
            <span class="timeline-duration">7-20 شهر</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">4</div>
          <div class="timeline-content">
            <h3>الإنهاء الإداري</h3>
            <span class="timeline-duration">اختياري</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="phase0" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">المرحلة <span>0</span>: تشخيصكم الاستراتيجي</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> المدة التقريبية: 1 إلى 3 أسابيع
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> الهدف الرئيسي</h3>
          <p>تقييم دقيق لأهليتكم للجنسية المغربية وتحديد الاستراتيجية المثلى قبل أي استثمار إضافي.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجراءاتنا الرئيسية</h3>
          <ul class="action-list">
            <li><strong>تحليل أولي</strong>: مراجعة معمقة للوثائق المقدمة.</li>
            <li><strong>مقابلة مفصلة</strong>: فهم تاريخكم العائلي وروابطكم بالمغرب.</li>
            <li><strong>جمع المعلومات</strong>: جمع منظم للمعلومات الشخصية والعائلية.</li>
            <li><strong>تقييم قانوني</strong>: مقارنة حالتكم بقانون الجنسية.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> تسليمكم الرئيسي</h3>
          <p>كتستلمو <strong>تقرير أهلية كامل</strong> كيتضمن:</p>
          <ul class="result-list">
            <li>تحديد قانوني واضح لحالتكم.</li>
            <li>تقييم شفاف لفرصكم الفعلية.</li>
            <li>لائحة أولية للوثائق الأساسية لي خاص تجمعو.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase1" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">المرحلة <span>1</span>: تكوين دقيق للملف</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> المدة التقريبية: 1 إلى 4 أشهر
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> الهدف الرئيسي</h3>
          <p>تجميع ملف كامل، متحقق منه بدقة ومطابق تماما لمتطلبات السلطات المغربية.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجراءاتنا الرئيسية</h3>
          <ul class="action-list">
            <li><strong>لائحة الوثائق</strong>: تقديم لائحة شخصية وشاملة.</li>
            <li><strong>دعم الجمع</strong>: مساعدة استباقية فالحصول على الوثائق المطلوبة (المغرب والخارج).</li>
            <li><strong>إدارة الترجمة</strong>: تنسيق الترجمات المحلفة اللازمة.</li>
            <li><strong>تتبع المصادقة</strong>: التعامل مع إجراءات التوثيق (أبوستيل، إلخ).</li>
            <li><strong>تحقق قانوني</strong>: مراجعة دقيقة لمطابقة كل وثيقة.</li>
            <li><strong>تجميع منهجي</strong>: تنظيم الملف حسب المعايير الإدارية.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> تسليمكم الرئيسي</h3>
          <p>ملف <strong>منتهي، جاهز للتقديم</strong>، كيتضمن:</p>
          <ul class="result-list">
            <li>جميع الوثائق الأصلية المطلوبة والمصادق عليها.</li>
            <li>جميع الترجمات المحلفة المطابقة.</li>
            <li>المصادقات والأبوستيل المناسبة.</li>
            <li>تنظيم واضح كيسهل المراجعة.</li>
            <li>جرد دقيق للمحتويات للتتبع.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase2" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">المرحلة <span>2</span>: تقديم محسن ومتابعة أولية</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> المدة التقريبية: 2 إلى 3 أشهر
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> الهدف الرئيسي</h3>
          <p>ضمان تقديم مطابق لملفكم وبدء متابعة إدارية فورية ودقيقة.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجراءاتنا الرئيسية</h3>
          <ul class="action-list">
            <li><strong>تقديم مستهدف</strong>: التقديم للسلطة المختصة الأكثر ملاءمة.</li>
            <li><strong>تأكيد التقديم</strong>: الحصول والتحقق من إثبات التقديم الرسمي.</li>
            <li><strong>مراقبة نشطة</strong>: تنفيذ متابعة منتظمة لحالة التقدم.</li>
            <li><strong>إدارة التحقيق</strong>: اهتمام خاص خلال مرحلة التحقيق الأمني.</li>
            <li><strong>استجابة كاملة</strong>: معالجة سريعة ودقيقة لأي طلبات إدارية إضافية.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> وضعكم</h3>
          <p>ملفكم <strong>مسجل رسميا ويتم تتبعه بنشاط</strong>، غايكون عندكم:</p>
          <ul class="result-list">
            <li>رقم ملفكم المرجعي.</li>
            <li>تأكيد القبول الإداري.</li>
            <li>توقع للخطوات التالية.</li>
            <li>نقطة اتصال محددة مع المصالح لي كدرس الملف.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase3" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">المرحلة <span>3</span>: الدعم حتى القرار النهائي</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> المدة التقريبية: 7 إلى 20 شهر
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> الهدف الرئيسي</h3>
          <p>تجاوز مرحلة الدراسة بكفاءة ومساعدتكم حتى الحصول على قرار إيجابي.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجراءاتنا الرئيسية</h3>
          <ul class="action-list">
            <li><strong>متابعة مستمرة</strong>: فحوصات دورية وتذكيرات إذا لزم الأمر.</li>
            <li><strong>تدخلات استراتيجية</strong>: إجراءات وقائية لتجنب أي عرقلة محتملة.</li>
            <li><strong>تحضير للموعد</strong>: مساعدة لوجستية وتحضير لمقابلتكم.</li>
            <li><strong>مساعدة فالموعد النهائي</strong>: حضور محامي شريك بجانبكم فالمحكمة.</li>
            <li><strong>تأمين الشهادة</strong>: المساعدة فاستلام الوثيقة الرسمية النهائية.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-passport" aria-hidden="true"></i> إنجازكم</h3>
          <p>الاعتراف الرسمي بوضعكم: <strong>الحصول على شهادة الجنسية المغربية ديالكم</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="phase4" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">المرحلة <span>4</span>: الإنهاء الإداري (اختياري)</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> المدة التقريبية: 1 إلى 3 أشهر
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> الهدف الرئيسي</h3>
          <p>تسهيل الإجراءات الإدارية المغربية بعد الحصول على جنسيتكم.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> إجراءاتنا الرئيسية</h3>
          <ul class="action-list">
            <li><strong>توجيه للهوية</strong>: نصائح واضحة للحصول على وثائقكم المغربية (بطاقة وطنية، جواز سفر).</li>
            <li><strong>دعم البطاقة الوطنية</strong>: مساعدة خاصة لإجراءات بطاقة التعريف الوطنية.</li>
            <li><strong>مساعدة الجواز</strong>: توجيه عبر عملية طلب جواز السفر.</li>
            <li><strong>توجيه إداري</strong>: نصائح حول خطوات مفيدة أخرى (تسجيل قنصلي، إلخ).</li>
            <li><strong>نصائح الاستقرار</strong>: موارد للناس لي كيفكرو يعيشو فالمغرب.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-id-card" aria-hidden="true"></i> اندماجكم الكامل</h3>
          <p>التمتع الكامل بمواطنتكم مع الحصول على <strong>وثائق هويتكم المغربية الرسمية</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section quality-section alt-bg">
    <div class="container">
      <h2 class="section-title">التزاماتنا: <span>الجودة والثقة</span></h2>
      <div class="quality-grid">
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-regular fa-eye" aria-hidden="true"></i></div>
          <h3>الشفافية</h3>
          <p>كتبقاو على علم دائم بالتقدم، الآجال، والخطوات التالية لملفكم.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-bolt-lightning" aria-hidden="true"></i></div>
          <h3>الاستجابة</h3>
          <p>كنجاوبو بسرعة على أسئلتكم وكنعالجو طلباتكم بجدية وكفاءة.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></div>
          <h3>متابعة شخصية</h3>
          <p>مستشار مخصص كيعرف ملفكم وكيرافقكم باهتمام من الأول للآخر.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></div>
          <h3>خبرة دقيقة</h3>
          <p>استافدو من معرفتنا العميقة والمحدثة بقانون الجنسية المغربي.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i></div>
          <h3>السرية</h3>
          <p>معلوماتكم الشخصية وملفكم كيتعاملو بأقصى درجات السرية.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">مستعد تبدا رحلتك نحو الجنسية المغربية؟</h2>
      <div class="cta-buttons">
        <a href="#phase0" class="btn btn-light">بدا بالتقييم</a>
        <a href="contact.html" class="btn btn-outline-light">طرح سؤال</a>
      </div>
    </div>
  </section>
  <CtaBanner lang={lang} />
</BaseLayout>
