---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es' as const;
---

<BaseLayout
  lang={lang}
  title="Quiz Interactivo de Marruecos | Ezra Maroc"
  description="Pon a prueba tus conocimientos sobre Marruecos con nuestro quiz interactivo y divertido. Descubre la historia, la cultura, la geografía y mucho más."
  currentPage="quiz"
  pageCSS={['quiz-page']}
>
  <section class="page-banner quiz-page-banner">
    <div class="container">
      <h2>Pon a Prueba tus Conocimientos sobre tu País</h2>
      <p>¡Pon tus conocimientos a prueba y descubre el Reino Cherifiano como nunca antes!</p>
    </div>
  </section>

  <main id="main-content">
    <section class="section quiz-main-content">
      <div class="container">
        <div class="quiz-container">
          <div class="confetti-container" id="confetti-container"></div>
          <div class="content">
            <h1 id="quiz-title">Quiz Majestuoso de Marruecos</h1>
            <p class="subtitle" id="quiz-subtitle">¡Pon a prueba tus conocimientos sobre el Reino Cherifiano!</p>

            <div id="theme-selection">
              <h2 id="theme-prompt" style="color: var(--primary-color); margin: 25px 0 15px; font-weight:600;">Elige un tema para comenzar la aventura:</h2>
              <div class="theme-selector" id="theme-selector"></div>
            </div>

            <div id="quiz-section" class="quiz-section">
              <div class="score-board">
                <div class="score"><span id="score-label">Puntuación: </span><span id="score">0</span>/<span id="total-questions-in-quiz">0</span></div>
                <div class="score-details"><span id="question-label">Pregunta</span> <span id="current-q-num">1</span> <span id="of-label">de</span> <span id="total-q-count">0</span></div>
                <div class="progress-bar">
                  <div class="progress-fill" id="progress"></div>
                </div>
              </div>
              <div class="theme-info" id="theme-info-display"></div>
              <div class="question-card">
                <div class="question" id="question"></div>
                <div class="answers" id="answers"></div>
                <div id="explanation-container" style="display:none;">
                  <p class="explanation" id="explanation-text"></p>
                </div>
              </div>
              <div style="margin-top:25px;">
                <button class="action-btn next-btn" id="next-btn" data-action="next" style="display: none;"><i class="fas fa-arrow-right" aria-hidden="true"></i> Siguiente</button>
                <button class="action-btn restart-btn" data-action="restart"><i class="fas fa-sync-alt" aria-hidden="true"></i> Nuevo tema</button>
              </div>
            </div>

            <div id="final-section" class="quiz-section">
              <div class="final-score-card">
                <h2 id="completion-title">¡Quiz Terminado! ¡Magnífico!</h2>
                <div class="score" id="final-score-text"></div>
                <div id="final-message"></div>
              </div>
              <div style="margin-top:25px;">
                <button class="action-btn restart-btn" data-action="retry"><i class="fas fa-redo" aria-hidden="true"></i> Reiniciar</button>
                <button class="action-btn next-btn" data-action="mixed"><i class="fas fa-dice" aria-hidden="true"></i> Quiz Mezclado</button>
              </div>
              <div class="quiz-cta" style="margin-top:30px; padding:20px; background:rgba(var(--primary-600-rgb,197,40,28),0.08); border-radius:10px; text-align:center;">
                <p style="font-size:1.05rem; margin-bottom:12px; font-weight:600; color:var(--dark-color,#333);">¡Compruebe su elegibilidad real para la nacionalidad marroquí!</p>
                <a href="contacto.html" class="btn btn-primary" style="display:inline-block;">Evaluación gratuita</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">¿Quieres saber más sobre Marruecos?</h2>
      <div class="cta-buttons">
        <a href="ventajas.html" class="btn btn-light">Descubrir las Ventajas</a>
        <a href="contacto.html" class="btn btn-outline-light">Contáctenos</a>
      </div>
    </div>
  </section>

  <script is:inline>window.QUIZ_CONFIG = { lang: 'es', dataUrl: '/js/quiz-data-es.json', quizLength: 10 };</script>
  <script is:inline src="/js/quiz-engine.js" defer></script>
</BaseLayout>
