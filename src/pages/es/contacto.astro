---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es' as const;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Ezra Maroc Consulting Services LLC",
  "url": "https://ezra-maroc.com",
  "logo": "https://ezra-maroc.com/img/logo.png",
  "image": "https://ezra-maroc.com/img/logo.png",
  "description": "Acompañamiento experto para la obtención de la nacionalidad marroquí por filiación.",
  "email": "info@ezra-project.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "30 N Gould St Ste R",
    "addressLocality": "Sheridan",
    "addressRegion": "WY",
    "postalCode": "82801",
    "addressCountry": "US"
  },
  "areaServed": ["FR", "MA", "US", "CA", "IL"],
  "availableLanguage": ["French", "English", "Spanish", "Hebrew", "Arabic"],
  "sameAs": ["https://www.instagram.com/ezramaroc/"]
};
---

<BaseLayout
  lang={lang}
  title="Contacta con Ezra Maroc | Obtén tu Nacionalidad Marroquí"
  description="Contacta con Ezra Maroc para una evaluación gratuita de tu elegibilidad para la nacionalidad marroquí o para cualquier pregunta sobre nuestros servicios de apoyo."
  currentPage="contact"
  pageCSS={['contact']}
  jsonLD={jsonLD}
>
  <main id="main-content" class="page-banner">
    <div class="container">
      <h1>Contáctanos</h1>
      <p>Haz tus preguntas o solicita una evaluación personalizada. Nuestro equipo está aquí para ayudarte.</p>
    </div>
  </main>

  <section class="section contact-section">
    <div class="container">
      <h2 class="section-title internal-title">Empecemos la <span>Conversación</span></h2>
      <div class="contact-grid">
        <div class="contact-info">
          <h3 class="info-title">Nuestros Datos de Contacto</h3>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Sede Administrativa</h4>
              <p>30 N Gould St Ste R,<br>Sheridan, WY 82801, USA</p>
              <span class="timezone">(Nota: Presencia administrativa únicamente)</span>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-envelope" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Contacto Principal</h4>
              <p><a href="mailto:info@ezra-project.fr">info@ezra-project.fr</a></p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Tiempo de Respuesta</h4>
              <p>Nos esforzamos por responder en 24-48 horas hábiles.</p>
              <span class="timezone">(Zona horaria de referencia: CET/París)</span>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Precisión</h4>
              <p>Para un análisis rápido y relevante, por favor, detalla tu situación familiar y tu solicitud lo máximo posible en el formulario.</p>
            </div>
          </div>

          <div class="social-media">
            <h4>Mantente Conectado</h4>
            <div class="social-icons">
              <a href="https://www.instagram.com/ezramaroc/" class="social-icon" aria-label="Instagram Ezra Maroc" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
            </div>
          </div>
        </div>

        <div class="contact-form-container" id="contact-form-container">
          <h3 class="form-title">Tu Mensaje</h3>

          <form id="contact-form" action="https://formspree.io/f/mjkwzpdr" method="POST" novalidate>
            <!-- Champ piege anti-robots (Formspree _gotcha) : invisible pour les visiteurs -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

            <div class="form-group">
              <label for="name">Nombre Completo <span class="required">*</span></label>
              <input type="text" id="name" name="name" required aria-required="true" placeholder="Ej: Juan Pérez" aria-invalid="false" aria-describedby="name-error">
              <span class="error-message" id="name-error" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="email">Dirección de Email <span class="required">*</span></label>
              <input type="email" id="email" name="email" required aria-required="true" placeholder="Ej: juan.perez@email.com" aria-invalid="false" aria-describedby="email-error">
              <span class="error-message" id="email-error" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="phone">Teléfono <span class="required required-indicator" style="display: none;">*</span><span class="optional-text">(Recomendado para seguimiento rápido)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="Ej: +34 600 123 456 (con código de país)" aria-invalid="false" aria-describedby="phone-error">
              <span class="error-message" id="phone-error" aria-live="polite"></span>
            </div>

            <div class="form-group">
              <label for="subject">Asunto de tu solicitud <span class="required">*</span></label>
              <select id="subject" name="subject" required aria-required="true" aria-invalid="false" aria-describedby="subject-error">
                <option value="" disabled selected>-- Por favor, elige un asunto --</option>
                <option value="Evaluación preliminar de mi elegibilidad">Evaluación preliminar de mi elegibilidad</option>
                <option value="Pregunta general sobre sus servicios">Pregunta general sobre sus servicios</option>
                <option value="Precisiones sobre el proceso de obtención">Precisiones sobre el proceso de obtención</option>
                <option value="Solicitud de información sobre tarifas">Solicitud de información sobre tarifas</option>
                <option value="Solicitud de devolución de llamada telefónica">Solicitud de devolución de llamada telefónica</option>
                <option value="Otro asunto">Otro asunto</option>
              </select>
              <span class="error-message" id="subject-error" aria-live="polite"></span>
            </div>

            <div class="form-group full-width" id="other-subject-group" style="display: none;">
              <label for="other_subject_details">Precisar el asunto de tu solicitud <span class="required">*</span></label>
              <input type="text" id="other_subject_details" name="other_subject_details" placeholder="Ej: Colaboración, Problema técnico..." aria-invalid="false" aria-describedby="other-subject-details-error">
              <span class="error-message" id="other-subject-details-error" aria-live="polite"></span>
            </div>

            <div class="form-group full-width">
              <label for="message">Detalles de tu solicitud <span class="required">*</span></label>
              <textarea id="message" name="message" rows="6" required aria-required="true" placeholder="Por favor, describe tu situación: ¿Quién en tu familia es/era marroquí (padre, madre, abuelo...)? ¿Cuándo nacieron/dejaron Marruecos? ¿Tienes documentos marroquíes (certificados de nacimiento, DNI, pasaporte...)? ¿Cuál es tu pregunta específica?" aria-invalid="false" aria-describedby="message-error" maxlength="3000"></textarea>
              <div id="char-counter" class="char-counter-display">Caracteres restantes: 1000</div>
              <span class="error-message" id="message-error" aria-live="polite"></span>
            </div>

            <div class="form-group full-width">
              <div class="checkbox-group" role="group" aria-labelledby="consent-label">
                <input type="checkbox" id="consent" name="consent" value="accepted" required aria-required="true" aria-invalid="false" aria-describedby="consent-error">
                <label for="consent" id="consent-label">Confirmo que he leído y acepto la <a href="politica-privacidad.html" target="_blank" rel="noopener noreferrer">política de privacidad</a> y las <a href="condiciones-uso.html" target="_blank" rel="noopener noreferrer">condiciones de uso</a>, y consiento el tratamiento de mis datos personales para permitir a Ezra Maroc responder a mi solicitud.<span class="required">*</span></label>
              </div>
              <span class="error-message" id="consent-error" aria-live="polite"></span>
            </div>

            <!-- Turnstile Anti-Spam -->
            <div class="form-group full-width">
              <div class="cf-turnstile" data-sitekey="VOTRE_SITE_KEY" data-theme="light"></div>
            </div>

            <div class="form-submit full-width">
              <button type="submit" class="btn btn-primary">
                <span class="btn-loader" aria-hidden="true"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Enviando...</span>
                <span class="btn-text">Enviar Mi Solicitud</span>
              </button>
            </div>

            <div id="form-message" class="form-message" role="alert" aria-live="assertive"></div>

          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="map-section" aria-label="Mapa mostrando nuestra sede administrativa">
    <h2 class="visually-hidden">Nuestra Sede Administrativa (USA)</h2>
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3050.058614989749!2d-106.958361684615!3d44.79916297909831!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5335f0e2f67f0a4f%3A0x579ff4e8b9e4b005!2s30%20N%20Gould%20St%20Ste%20R%2C%20Sheridan%2C%20WY%2082801%2C%20USA!5e0!3m2!1sen!2sfr!4v1678886541234!5m2!1sen!2sfr"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen=""
        sandbox="allow-scripts allow-same-origin"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Google Maps mostrando la dirección 30 N Gould St Ste R, Sheridan, WY">
      </iframe>
    </div>
  </section>
</BaseLayout>
