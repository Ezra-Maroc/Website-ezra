---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const lang = 'en' as const;
---

<BaseLayout
  lang={lang}
  title="Our Clear and Structured Process | Ezra Maroc"
  description="Discover Ezra Maroc's structured methodology designed to guide you smoothly and effectively towards obtaining your Moroccan nationality."
  currentPage="process"
  canonicalPath="/en/process.html"
  pageCSS={['processus']}
>
  <main id="main-content" class="page-banner">
    <div class="container">
      <h1>Our Proven Process</h1>
      <p>Discover our structured methodology, designed to guide you smoothly and effectively towards obtaining your Moroccan nationality.</p>
    </div>
  </main>

  <section class="section overview-section">
    <div class="container">
      <h2 class="section-title">Your Simplified Journey: <span>Overview</span></h2>
      <p class="overview-text">We have broken down the path to nationality into clear, distinct steps. Each phase is designed to progress methodically, with specific goals and full transparency, maximizing your chances of success.</p>
      <div class="process-timeline">
        <div class="timeline-item">
          <div class="timeline-number">0</div>
          <div class="timeline-content">
            <h3>Initial Diagnosis</h3>
            <span class="timeline-duration">1-3 weeks</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">1</div>
          <div class="timeline-content">
            <h3>File Compilation</h3>
            <span class="timeline-duration">1-4 months</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">2</div>
          <div class="timeline-content">
            <h3>Submission &amp; Initial Follow-up</h3>
            <span class="timeline-duration">2-3 months</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">3</div>
          <div class="timeline-content">
            <h3>Review &amp; Decision</h3>
            <span class="timeline-duration">7-20 months</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">4</div>
          <div class="timeline-content">
            <h3>Admin. Finalization</h3>
            <span class="timeline-duration">Optional</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="phase0" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">Phase <span>0</span>: Your Strategic Diagnosis</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Indicative duration: 1 to 3 weeks
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Main Objective</h3>
          <p>Precisely assess your eligibility for Moroccan nationality and define the optimal strategy before further investment.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Our Key Actions</h3>
          <ul class="action-list">
            <li><strong>Initial Analysis</strong>: Thorough review of provided documents.</li>
            <li><strong>Detailed Interview</strong>: Understanding your family background and ties to Morocco.</li>
            <li><strong>Info Gathering</strong>: Structured collection of personal and family information.</li>
            <li><strong>Legal Assessment</strong>: Comparing your case against the Nationality Code.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Your Key Deliverable</h3>
          <p>You receive a <strong>complete eligibility report</strong> including:</p>
          <ul class="result-list">
            <li>Clear legal positioning of your case.</li>
            <li>Transparent assessment of your actual chances.</li>
            <li>Indicative list of essential documents to gather.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase1" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">Phase <span>1</span>: Rigorous File Compilation</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Indicative duration: 1 to 4 months
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Main Objective</h3>
          <p>Assemble a complete, rigorously verified file perfectly aligned with the requirements of Moroccan authorities.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Our Key Actions</h3>
          <ul class="action-list">
            <li><strong>Document List</strong>: Providing a personalized and exhaustive list.</li>
            <li><strong>Collection Support</strong>: Proactive assistance in obtaining required documents (Morocco &amp; abroad).</li>
            <li><strong>Translation Management</strong>: Coordination of necessary sworn translations.</li>
            <li><strong>Legalization Tracking</strong>: Handling authentication procedures (Apostille, etc.).</li>
            <li><strong>Legal Verification</strong>: Meticulous review of each document's compliance.</li>
            <li><strong>Methodical Assembly</strong>: Organizing the file according to administrative standards.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Your Key Deliverable</h3>
          <p>A <strong>finalized file, ready for submission</strong>, containing:</p>
          <ul class="result-list">
            <li>All required and validated original documents.</li>
            <li>All compliant sworn translations.</li>
            <li>Appropriate legalizations and apostilles.</li>
            <li>Clear organization facilitating review.</li>
            <li>A precise inventory of contents for tracking.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase2" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">Phase <span>2</span>: Optimized Submission &amp; Initial Follow-up</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Indicative duration: 2 to 3 months
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Main Objective</h3>
          <p>Ensure compliant submission of your file and initiate immediate and rigorous administrative follow-up.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Our Key Actions</h3>
          <ul class="action-list">
            <li><strong>Targeted Submission</strong>: Submitting to the most relevant competent authority.</li>
            <li><strong>Submission Confirmation</strong>: Obtaining and verifying official proof of submission.</li>
            <li><strong>Active Monitoring</strong>: Implementing regular follow-up on the progress status.</li>
            <li><strong>Investigation Management</strong>: Special attention during the security investigation phase.</li>
            <li><strong>Total Responsiveness</strong>: Quick and precise handling of any additional administrative requests.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> Your Status</h3>
          <p>Your file is <strong>officially registered and actively tracked</strong>, you will have:</p>
          <ul class="result-list">
            <li>Your reference file number.</li>
            <li>Confirmation of administrative admissibility.</li>
            <li>A forecast of the next steps.</li>
            <li>Established contact point with the reviewing services.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase3" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">Phase <span>3</span>: Support Until the Final Decision</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Indicative duration: 7 to 20 months
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Main Objective</h3>
          <p>Efficiently navigate the review phase and assist you until obtaining a favorable decision.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Our Key Actions</h3>
          <ul class="action-list">
            <li><strong>Continuous Follow-up</strong>: Periodic checks and reminders if necessary.</li>
            <li><strong>Strategic Interventions</strong>: Preventive actions to avoid potential blockages.</li>
            <li><strong>Appointment Preparation</strong>: Logistical assistance and preparation for your interview.</li>
            <li><strong>Final Appointment Assistance</strong>: Presence of a partner lawyer by your side at the court.</li>
            <li><strong>Certificate Securing</strong>: Help in retrieving the final official document.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-passport" aria-hidden="true"></i> Your Achievement</h3>
          <p>The official recognition of your status: <strong>obtaining your Moroccan certificate of nationality</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="phase4" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">Phase <span>4</span>: Administrative Finalization (Optional)</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> Indicative duration: 1 to 3 months
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> Main Objective</h3>
          <p>Facilitate Moroccan administrative procedures following the acquisition of your nationality.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Our Key Actions</h3>
          <ul class="action-list">
            <li><strong>Identity Guidance</strong>: Clear advice for obtaining your Moroccan documents (CNIE, passport).</li>
            <li><strong>CNIE Support</strong>: Specific assistance for national ID card formalities.</li>
            <li><strong>Passport Help</strong>: Guidance through the passport application process.</li>
            <li><strong>Admin. Orientation</strong>: Advice on other useful steps (consulate registration, etc.).</li>
            <li><strong>Settling-in Advice</strong>: Resources for those considering living in Morocco.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-id-card" aria-hidden="true"></i> Your Full Integration</h3>
          <p>Full enjoyment of your citizenship with the acquisition of your <strong>official Moroccan identity documents</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section quality-section alt-bg">
    <div class="container">
      <h2 class="section-title">Our Commitments: <span>Quality &amp; Trust</span></h2>
      <div class="quality-grid">
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-regular fa-eye" aria-hidden="true"></i></div>
          <h3>Transparency</h3>
          <p>You are constantly informed about the progress, timelines, and next steps of your file.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-bolt-lightning" aria-hidden="true"></i></div>
          <h3>Responsiveness</h3>
          <p>We quickly answer your questions and handle your requests with diligence and efficiency.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></div>
          <h3>Personalized Follow-up</h3>
          <p>A dedicated advisor knows your file and supports you attentively from A to Z.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></div>
          <h3>Sharp Expertise</h3>
          <p>Benefit from our in-depth and up-to-date knowledge of Moroccan nationality law.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i></div>
          <h3>Confidentiality</h3>
          <p>Your personal information and your file are treated with the strictest confidentiality.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">Ready to start your journey towards Moroccan nationality?</h2>
      <div class="cta-buttons">
        <a href="#phase0" class="btn btn-light">Start with the Evaluation</a>
        <a href="contact.html" class="btn btn-outline-light">Ask a Question</a>
      </div>
    </div>
  </section>
  <CtaBanner lang={lang} />
</BaseLayout>
