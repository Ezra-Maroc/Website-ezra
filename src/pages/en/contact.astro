---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'en' as const;

const jsonLD = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "Ezra Maroc Consulting Services LLC",
  "url": "https://ezra-maroc.com",
  "logo": "https://ezra-maroc.com/img/logo.png",
  "image": "https://ezra-maroc.com/img/logo.png",
  "description": "Expert guidance for obtaining Moroccan nationality through lineage.",
  "email": "info@ezra-project.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "30 N Gould St Ste R",
    "addressLocality": "Sheridan",
    "addressRegion": "WY",
    "postalCode": "82801",
    "addressCountry": "US"
  },
  "areaServed": ["FR", "MA", "US", "CA", "IL"],
  "availableLanguage": ["French", "English", "Spanish", "Hebrew", "Arabic"],
  "sameAs": ["https://www.instagram.com/ezramaroc/"]
};
---

<BaseLayout
  lang={lang}
  title="Contact Ezra Maroc | Get Your Moroccan Nationality"
  description="Contact Ezra Maroc for a free assessment of your eligibility for Moroccan nationality or for any questions about our support services."
  currentPage="contact"
  pageCSS={['contact']}
  jsonLD={jsonLD}
>
  <!-- Page Banner -->
  <main id="main-content" class="page-banner">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Ask your questions or request a personalized assessment. Our team is here to help you.</p>
    </div>
  </main>

  <!-- Main Contact Section -->
  <section class="section contact-section">
    <div class="container">
      <h2 class="section-title internal-title">Let's Start the <span>Conversation</span></h2>

      <!-- Contact Grid (Info + Form) -->
      <div class="contact-grid">

        <!-- Contact Info Column -->
        <div class="contact-info">
          <h3 class="info-title">Our Contact Details</h3>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Administrative Office</h4>
              <p>30 N Gould St Ste R,<br>Sheridan, WY 82801, USA</p>
              <span class="timezone">(Note: Administrative presence only)</span>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-envelope" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Main Contact</h4>
              <p><a href="mailto:info@ezra-project.fr">info@ezra-project.fr</a></p>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-regular fa-clock" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Response Time</h4>
              <p>We strive to reply within 24-48 business hours.</p>
              <span class="timezone">(Reference time zone: CET/Paris)</span>
            </div>
          </div>

          <div class="info-item">
            <div class="info-icon"><i class="fa-solid fa-circle-info" aria-hidden="true"></i></div>
            <div class="info-content">
              <h4>Accuracy</h4>
              <p>For a quick and relevant analysis, please detail your family situation and request as much as possible in the form.</p>
            </div>
          </div>

          <div class="social-media">
            <h4>Stay Connected</h4>
            <div class="social-icons">
              <a href="https://www.instagram.com/ezramaroc/" class="social-icon" aria-label="Instagram Ezra Maroc" target="_blank" rel="noopener noreferrer"><i class="fa-brands fa-instagram" aria-hidden="true"></i></a>
            </div>
          </div>
        </div> <!-- End Contact Info Column -->

        <!-- Form Column -->
        <div class="contact-form-container" id="contact-form-container">
          <h3 class="form-title">Your Message</h3>

          <!-- The Form -->
          <form id="contact-form" action="https://formspree.io/f/mjkwzpdr" method="POST" novalidate>
            <!-- Champ piege anti-robots (Formspree _gotcha) : invisible pour les visiteurs -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

            <!-- Full Name Field -->
            <div class="form-group">
              <label for="name">Full Name <span class="required">*</span></label>
              <input type="text" id="name" name="name" required aria-required="true" placeholder="Ex: John Doe" aria-invalid="false" aria-describedby="name-error">
              <span class="error-message" id="name-error" aria-live="polite"></span>
            </div>

            <!-- Email Field -->
            <div class="form-group">
              <label for="email">Email Address <span class="required">*</span></label>
              <input type="email" id="email" name="email" required aria-required="true" placeholder="Ex: john.doe@email.com" aria-invalid="false" aria-describedby="email-error">
              <span class="error-message" id="email-error" aria-live="polite"></span>
            </div>

            <!-- Phone Field -->
            <div class="form-group">
              <label for="phone">Phone <span class="required required-indicator" style="display: none;">*</span><span class="optional-text">(Recommended for quick follow-up)</span></label>
              <input type="tel" id="phone" name="phone" placeholder="Ex: +1 555 123 4567 (with country code)" aria-invalid="false" aria-describedby="phone-error">
              <span class="error-message" id="phone-error" aria-live="polite"></span>
            </div>

            <!-- Subject Field -->
            <div class="form-group">
              <label for="subject">Subject of your request <span class="required">*</span></label>
              <select id="subject" name="subject" required aria-required="true" aria-invalid="false" aria-describedby="subject-error">
                <option value="" disabled selected>-- Please choose a subject --</option>
                <option value="Preliminary eligibility assessment">Preliminary eligibility assessment</option>
                <option value="General question about your services">General question about your services</option>
                <option value="Details about the application process">Details about the application process</option>
                <option value="Request for pricing information">Request for pricing information</option>
                <option value="Request for a callback">Request for a callback</option>
                <option value="Other subject">Other subject</option>
              </select>
              <span class="error-message" id="subject-error" aria-live="polite"></span>
            </div>

            <!-- Specify other subject (initially hidden) -->
            <div class="form-group full-width" id="other-subject-group" style="display: none;">
              <label for="other_subject_details">Please specify the subject of your request <span class="required">*</span></label>
              <input type="text" id="other_subject_details" name="other_subject_details" placeholder="Ex: Partnership, Technical issue..." aria-invalid="false" aria-describedby="other-subject-details-error">
              <span class="error-message" id="other-subject-details-error" aria-live="polite"></span>
            </div>

            <!-- Message Field -->
            <div class="form-group full-width">
              <label for="message">Details of your request <span class="required">*</span></label>
              <textarea id="message" name="message" rows="6" required aria-required="true" placeholder="Please describe your situation: Who in your family is/was Moroccan (father, mother, grandfather...)? When were they born/did they leave Morocco? Do you have any Moroccan documents (birth certificates, ID card, passport...)? What is your specific question?" aria-invalid="false" aria-describedby="message-error" maxlength="3000"></textarea>
              <!-- Character counter -->
              <div id="char-counter" class="char-counter-display">Characters remaining: 1000</div>
              <span class="error-message" id="message-error" aria-live="polite"></span>
            </div>

            <!-- Privacy Policy Consent Field -->
            <div class="form-group full-width">
              <div class="checkbox-group" role="group" aria-labelledby="consent-label">
                <input type="checkbox" id="consent" name="consent" value="accepted" required aria-required="true" aria-invalid="false" aria-describedby="consent-error">
                <label for="consent" id="consent-label">I confirm I have read and accept the <a href="privacy-policy.html" target="_blank" rel="noopener noreferrer">privacy policy</a> and the <a href="terms-of-service.html" target="_blank" rel="noopener noreferrer">Terms of Service</a>, and consent to the processing of my personal data to allow Ezra Maroc to respond to my request.<span class="required">*</span></label>
              </div>
              <span class="error-message" id="consent-error" aria-live="polite"></span>
            </div>

            <!-- Turnstile Anti-Spam -->
            <div class="form-group full-width">
              <div class="cf-turnstile" data-sitekey="VOTRE_SITE_KEY" data-theme="light"></div>
            </div>

            <!-- Submit Button -->
            <div class="form-submit full-width">
              <button type="submit" class="btn btn-primary">
                <span class="btn-loader" aria-hidden="true"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i> Sending...</span>
                <span class="btn-text">Send My Request</span>
              </button>
            </div>

            <!-- Zone for displaying global messages (success/error) -->
            <div id="form-message" class="form-message" role="alert" aria-live="assertive"></div>

          </form> <!-- End Form -->
        </div> <!-- End Form Column -->

      </div> <!-- End Contact Grid -->
    </div> <!-- End Container -->
  </section> <!-- End Contact Section -->

  <!-- Map Section -->
  <section class="map-section" aria-label="Map showing our administrative office">
    <h2 class="visually-hidden">Our Administrative Office (USA)</h2>
    <div class="map-container">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3050.058614989749!2d-106.958361684615!3d44.79916297909831!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x5335f0e2f67f0a4f%3A0x579ff4e8b9e4b005!2s30%20N%20Gould%20St%20Ste%20R%2C%20Sheridan%2C%20WY%2082801%2C%20USA!5e0!3m2!1sen!2sfr!4v1678886541234!5m2!1sen!2sfr"
        width="100%"
        height="450"
        style="border:0;"
        allowfullscreen=""
        sandbox="allow-scripts allow-same-origin"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Google Maps showing address 30 N Gould St Ste R, Sheridan, WY">
      </iframe>
    </div>
  </section>
</BaseLayout>
