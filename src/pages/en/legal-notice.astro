  title="Legal Notice | Ezra Maroc"
  description="Legal information concerning the website www.ezra-maroc.com, published by Ezra Maroc Consulting Services LLC."
  currentPage="legal-notice"
  noindex={true}
>
    <!-- LEGAL NOTICE CONTENT -->
    <main id="main-content" class="page-banner">
        <div class="container">
            <h1>Legal Notice</h1>
            <p>Information regarding the website www.ezra-maroc.com</p>
        </div>
    </main>

  <LegalNav lang={lang} pageTitle="Legal Notice" />

  <section class="section legal-content-section">
        <div class="container">

            <p><strong>Last Updated:</strong> May 8, 2024</p>

            <h2>ARTICLE 1: Site Editor</h2>
            <p>The website https://www.ezra-maroc.com (hereinafter the "Site") is published by:</p>
            <p>
                <strong>Ezra Maroc Consulting Services LLC</strong><br>
                A Limited Liability Company registered in the State of Wyoming, USA.<br>
                Registration Number: [Your Wyoming Registration Number - TO BE COMPLETED]<br>
                Registered Office: 30 N Gould St Ste R, Sheridan, WY 82801, USA<br>
