---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrganizationJsonLD } from '../../i18n/jsonld';

const lang = 'en' as const;
const jsonLD = getOrganizationJsonLD(lang);
---

<BaseLayout
  lang={lang}
  title="Ezra Maroc - Obtain Moroccan Nationality | Expert Support"
  description="Obtain Moroccan nationality through family ties with Ezra Maroc: personalized support and transparent follow-up at every step."
  currentPage="home"
  jsonLD={jsonLD}
>
  <main id="main-content" class="hero">
    <div class="container hero-content">
      <h1>Your Gateway to Moroccan Nationality</h1>
      <p>We guide you step-by-step in your process of obtaining Moroccan nationality with tailored support and cutting-edge legal expertise.</p>
      <div class="hero-buttons">
        <a href="/en/services.html" class="btn btn-light">Discover Our Services</a>
        <a href="/en/process.html" class="btn btn-light">Our Simplified Process</a>
        <a href="/en/contact.html" class="btn btn-primary">Free Assessment</a>
      </div>
    </div>
  </main>

  <section class="section intro-section">
    <div class="container">
      <p class="intro-text">Easily connect with your Moroccan heritage. Ezra Maroc, a recognized specialist, successfully supports you at every stage of your nationality application, from the initial assessment to the delivery of your nationality certificate.</p>
      <div class="strengths">
        <div class="strength-item">
          <i class="fa-solid fa-scale-balanced strength-icon" aria-hidden="true"></i>
          <h3>Specialized Legal Expertise</h3>
          <p>in Moroccan nationality law</p>
        </div>
        <div class="strength-item">
          <i class="fa-solid fa-handshake-angle strength-icon" aria-hidden="true"></i>
          <h3>Personalized Support</h3>
          <p>throughout your entire process</p>
        </div>
        <div class="strength-item">
          <i class="fa-solid fa-network-wired strength-icon" aria-hidden="true"></i>
          <h3>Established Network</h3>
          <p>with Moroccan administrations</p>
        </div>
        <div class="strength-item">
          <i class="fa-solid fa-file-circle-check strength-icon" aria-hidden="true"></i>
          <h3>Documentary Rigor</h3>
          <p>every document checked before filing</p>
        </div>
        <div class="strength-item">
          <i class="fa-solid fa-lightbulb strength-icon" aria-hidden="true"></i>
          <h3>Total Transparency</h3>
          <p>on the process and timelines</p>
        </div>
      </div>
    </div>
  </section>

  <section id="our-services" class="section services-section">
    <div class="container">
      <h2 class="section-title">Our <span>Services</span></h2>
      <div class="features">
        <div class="feature-card">
          <i class="fa-solid fa-magnifying-glass feature-icon" aria-hidden="true"></i>
          <h3 class="feature-title">Eligibility Assessment</h3>
          <p>We analyze your family situation and ties to Morocco to accurately determine your rights to Moroccan nationality.</p>
        </div>
        <div class="feature-card">
          <i class="fa-solid fa-folder-open feature-icon" aria-hidden="true"></i>
          <h3 class="feature-title">File Compilation</h3>
          <p>Meticulous preparation of all necessary documents to build a strong file compliant with Moroccan authorities' requirements.</p>
        </div>
        <div class="feature-card">
          <i class="fa-solid fa-clipboard-check feature-icon" aria-hidden="true"></i>
          <h3 class="feature-title">Administrative Follow-up</h3>
          <p>Active monitoring of your file's progress with Moroccan administrations and prompt intervention when needed.</p>
        </div>
      </div>
      <div class="services-more">
        <a href="/en/services.html" class="btn-link">Discover all our services <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section id="why-us" class="section why-us-section">
    <div class="container">
      <h2 class="section-title">Why Choose <span>Ezra Maroc?</span></h2>
      <div class="why-us-grid">
        <div class="why-us-item">
          <i class="fa-solid fa-key why-us-icon" aria-hidden="true"></i>
          <h3>Turnkey Approach</h3>
          <p>freeing you from administrative hassles</p>
        </div>
        <div class="why-us-item">
          <i class="fa-solid fa-gavel why-us-icon" aria-hidden="true"></i>
          <h3>Sharp Legal Expertise</h3>
          <p>in Moroccan nationality law</p>
        </div>
        <div class="why-us-item">
          <i class="fa-solid fa-user-tie why-us-icon" aria-hidden="true"></i>
          <h3>Dedicated Contact</h3>
          <p>for personalized follow-up</p>
        </div>
        <div class="why-us-item">
          <i class="fa-solid fa-glasses why-us-icon" aria-hidden="true"></i>
          <h3>Total Transparency</h3>
          <p>on the progress of your file</p>
        </div>
        <div class="why-us-item">
          <i class="fa-solid fa-globe why-us-icon" aria-hidden="true"></i>
          <h3>Established Network</h3>
          <p>of lawyers and partners in Morocco</p>
        </div>
      </div>
      <div style="text-align: center; margin-top: 40px;">
        <a href="/en/about.html" class="btn-link">Discover our team and values <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section id="process" class="section process-section">
    <div class="container">
      <h2 class="section-title">Our Simplified <span>Process</span></h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3 class="step-title">Eligibility Assessment</h3>
            <p>Complete analysis of your situation and potential rights to Moroccan nationality.</p>
            <span class="step-duration">1-3 weeks</span>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3 class="step-title">File Compilation</h3>
            <p>Gathering and preparation of all required documents for your application.</p>
            <span class="step-duration">1-4 months</span>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3 class="step-title">Submission &amp; Admin. Follow-up</h3>
            <p>Submitting your file to the relevant authorities and close monitoring.</p>
            <span class="step-duration">2-3 months</span>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">4</div>
          <div class="step-content">
            <h3 class="step-title">Review and Decision</h3>
            <p>Period of examination of your file by the Moroccan authorities.</p>
            <span class="step-duration">7-20 months+</span>
          </div>
        </div>
        <div class="process-step">
          <div class="step-number">5</div>
          <div class="step-content">
            <h3 class="step-title">Finalization &amp; Documents</h3>
            <p>Assistance in obtaining your Moroccan documents (CNIE, passport...) once nationality is granted.</p>
            <span class="step-duration">Optional Service</span>
          </div>
        </div>
      </div>
      <div class="process-more">
        <a href="/en/process.html" class="btn-link">Learn more about our process <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
      </div>
    </div>
  </section>

  <section id="testimonials" class="section testimonial-section">
    <div class="container">
      <h2 class="section-title">Their Journeys, <span>Our Pride</span></h2>
      <div class="testimonial">
        <div class="testimonial-content">
          <p class="testimonial-text">"After years of unsuccessful attempts, Ezra Maroc managed to get me Moroccan nationality in less than a year. Their expertise and professionalism made all the difference."</p>
        </div>
        <div class="testimonial-client">
          <h3>David C.</h3>
          <p>Paris, France</p>
        </div>
        <div class="testimonials-more">
          <a href="/en/testimonials.html" class="btn-link">See all testimonials <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">Ready to start your journey towards Moroccan nationality?</h2>
      <div class="cta-buttons">
        <a href="/en/services.html" class="btn btn-outline-light">See Our Services</a>
        <a href="/en/contact.html" class="btn btn-outline-light">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
