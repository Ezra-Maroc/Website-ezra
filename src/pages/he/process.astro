---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const lang = 'he' as const;
---

<BaseLayout
  lang={lang}
  title="התהליך הברור והמובנה שלנו | עזרא מרוק"
  description="גלו את המתודולוגיה המובנית של עזרא מרוק, שנועדה להדריך אתכם בצורה חלקה ויעילה לקראת קבלת האזרחות המרוקאית שלכם."
  currentPage="process"
  pageCSS={['processus']}
>
  <main id="main-content" class="page-banner">
    <div class="container">
      <h1>התהליך המוכח שלנו</h1>
      <p>גלו את המתודולוגיה המובנית שלנו, שנועדה להדריך אתכם בצורה חלקה ויעילה לקראת קבלת האזרחות המרוקאית שלכם.</p>
    </div>
  </main>

  <section class="section overview-section">
    <div class="container">
      <h2 class="section-title">המסע הפשוט שלכם: <span>סקירה כללית</span></h2>
      <p class="overview-text">פירקנו את הדרך לאזרחות לשלבים ברורים ונפרדים. כל שלב נועד להתקדם באופן שיטתי, עם יעדים ספציפיים ושקיפות מלאה, תוך מקסום סיכויי ההצלחה שלכם.</p>
      <div class="process-timeline">
        <div class="timeline-item">
          <div class="timeline-number">0</div>
          <div class="timeline-content">
            <h3>אבחון ראשוני</h3>
            <span class="timeline-duration">1-3 שבועות</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">1</div>
          <div class="timeline-content">
            <h3>הרכבת התיק</h3>
            <span class="timeline-duration">1-4 חודשים</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">2</div>
          <div class="timeline-content">
            <h3>הגשה ומעקב ראשוני</h3>
            <span class="timeline-duration">2-3 חודשים</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">3</div>
          <div class="timeline-content">
            <h3>בדיקה והחלטה</h3>
            <span class="timeline-duration">7-20 חודשים</span>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-number">4</div>
          <div class="timeline-content">
            <h3>סיום מנהלי</h3>
            <span class="timeline-duration">אופציונלי</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="phase0" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">שלב <span>0</span>: האבחון האסטרטגי שלכם</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> משך זמן משוער: 1 עד 3 שבועות
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> מטרה עיקרית</h3>
          <p>להעריך במדויק את זכאותכם לאזרחות מרוקאית ולהגדיר את האסטרטגיה המיטבית לפני השקעה נוספת.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> פעולות המפתח שלנו</h3>
          <ul class="action-list">
            <li><strong>ניתוח ראשוני</strong>: בדיקה יסודית של המסמכים שסופקו.</li>
            <li><strong>ראיון מפורט</strong>: הבנת הרקע המשפחתי שלכם והקשרים למרוקו.</li>
            <li><strong>איסוף מידע</strong>: איסוף מובנה של מידע אישי ומשפחתי.</li>
            <li><strong>הערכה משפטית</strong>: השוואת המקרה שלכם מול קוד האזרחות.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> התוצר המרכזי שלכם</h3>
          <p>אתם מקבלים <strong>דו"ח זכאות מלא</strong> הכולל:</p>
          <ul class="result-list">
            <li>מיצוב משפטי ברור של המקרה שלכם.</li>
            <li>הערכה שקופה של הסיכויים הממשיים שלכם.</li>
            <li>רשימה אינדיקטיבית של מסמכים חיוניים לאיסוף.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase1" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">שלב <span>1</span>: הרכבת תיק קפדנית</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> משך זמן משוער: 1 עד 4 חודשים
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> מטרה עיקרית</h3>
          <p>להרכיב תיק מלא, מאומת בקפדנות, התואם באופן מושלם לדרישות הרשויות המרוקאיות.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> פעולות המפתח שלנו</h3>
          <ul class="action-list">
            <li><strong>רשימת מסמכים</strong>: מתן רשימה אישית וממצה.</li>
            <li><strong>תמיכה באיסוף</strong>: סיוע פרואקטיבי בהשגת המסמכים הנדרשים (מרוקו ומחוצה לה).</li>
            <li><strong>ניהול תרגומים</strong>: תיאום התרגומים המושבעים הנדרשים.</li>
            <li><strong>מעקב אחר אישורים</strong>: טיפול בהליכי אימות (אפוסטיל וכו').</li>
            <li><strong>אימות משפטי</strong>: בדיקה קפדנית של תאימות כל מסמך.</li>
            <li><strong>הרכבה שיטתית</strong>: ארגון התיק בהתאם לסטנדרטים מנהליים.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> התוצר המרכזי שלכם</h3>
          <p>תיק <strong>גמור, מוכן להגשה</strong>, המכיל:</p>
          <ul class="result-list">
            <li>כל המסמכים המקוריים הנדרשים והמאומתים.</li>
            <li>כל התרגומים המושבעים התואמים.</li>
            <li>אישורים ואפוסטילים מתאימים.</li>
            <li>ארגון ברור המקל על הבדיקה.</li>
            <li>רשימת תכולה מדויקת למעקב.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase2" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">שלב <span>2</span>: הגשה ממוטבת ומעקב ראשוני</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> משך זמן משוער: 2 עד 3 חודשים
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> מטרה עיקרית</h3>
          <p>להבטיח הגשה תקינה של התיק שלכם וליזום מעקב מנהלי מיידי וקפדני.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> פעולות המפתח שלנו</h3>
          <ul class="action-list">
            <li><strong>הגשה ממוקדת</strong>: הגשה לרשות המוסמכת הרלוונטית ביותר.</li>
            <li><strong>אישור הגשה</strong>: קבלת ואימות הוכחת הגשה רשמית.</li>
            <li><strong>ניטור פעיל</strong>: יישום מעקב קבוע אחר מצב ההתקדמות.</li>
            <li><strong>ניהול חקירה</strong>: תשומת לב מיוחדת במהלך שלב חקירת הביטחון.</li>
            <li><strong>תגובה מהירה</strong>: טיפול מהיר ומדויק בכל בקשה מנהלית נוספת.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-flag-checkered" aria-hidden="true"></i> הסטטוס שלכם</h3>
          <p>התיק שלכם <strong>רשום רשמית ונמצא במעקב פעיל</strong>, יהיו לכם:</p>
          <ul class="result-list">
            <li>מספר התיק שלכם לעיון.</li>
            <li>אישור על קבילות מנהלית.</li>
            <li>תחזית לשלבים הבאים.</li>
            <li>נקודת קשר מבוססת עם שירותי הבדיקה.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="phase3" class="section phase-section alt-bg">
    <div class="container">
      <h2 class="section-title internal-title">שלב <span>3</span>: תמיכה עד להחלטה הסופית</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> משך זמן משוער: 7 עד 20 חודשים
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> מטרה עיקרית</h3>
          <p>לנווט ביעילות את שלב הבדיקה ולסייע לכם עד לקבלת החלטה חיובית.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> פעולות המפתח שלנו</h3>
          <ul class="action-list">
            <li><strong>מעקב רציף</strong>: בדיקות תקופתיות ותזכורות במידת הצורך.</li>
            <li><strong>התערבויות אסטרטגיות</strong>: פעולות מנע למניעת חסימות פוטנציאליות.</li>
            <li><strong>הכנה לפגישה</strong>: סיוע לוגיסטי והכנה לראיון שלכם.</li>
            <li><strong>סיוע בפגישה הסופית</strong>: נוכחות של עורך דין שותף לצידכם בבית המשפט.</li>
            <li><strong>הבטחת התעודה</strong>: עזרה באיסוף המסמך הרשמי הסופי.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-passport" aria-hidden="true"></i> ההישג שלכם</h3>
          <p>ההכרה הרשמית במעמדכם: <strong>קבלת תעודת האזרחות המרוקאית שלכם</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="phase4" class="section phase-section">
    <div class="container">
      <h2 class="section-title internal-title">שלב <span>4</span>: סיום מנהלי (אופציונלי)</h2>
      <div class="phase-duration">
        <i class="fa-regular fa-clock" aria-hidden="true"></i> משך זמן משוער: 1 עד 3 חודשים
      </div>
      <div class="phase-content">
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-bullseye" aria-hidden="true"></i> מטרה עיקרית</h3>
          <p>להקל על ההליכים המנהליים המרוקאיים לאחר רכישת האזרחות.</p>
        </div>
        <div class="phase-block">
          <h3 class="block-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> פעולות המפתח שלנו</h3>
          <ul class="action-list">
            <li><strong>הכוונת זהות</strong>: ייעוץ ברור לקבלת מסמכי הזהות המרוקאיים שלכם (CNIE, דרכון).</li>
            <li><strong>תמיכה ב-CNIE</strong>: סיוע ספציפי לפורמליות של תעודת הזהות הלאומית.</li>
            <li><strong>עזרה בדרכון</strong>: הכוונה בתהליך הגשת הבקשה לדרכון.</li>
            <li><strong>הכוונה מנהלית</strong>: ייעוץ לגבי צעדים שימושיים אחרים (רישום בקונסוליה וכו').</li>
            <li><strong>ייעוץ להתיישבות</strong>: משאבים עבור אלה השוקלים לגור במרוקו.</li>
          </ul>
        </div>
        <div class="phase-block result-block">
          <h3 class="block-title"><i class="fa-solid fa-id-card" aria-hidden="true"></i> ההשתלבות המלאה שלכם</h3>
          <p>הנאה מלאה מאזרחותכם עם רכישת <strong>מסמכי הזהות המרוקאיים הרשמיים</strong> שלכם.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section quality-section alt-bg">
    <div class="container">
      <h2 class="section-title">ההתחייבויות שלנו: <span>איכות ואמון</span></h2>
      <div class="quality-grid">
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-regular fa-eye" aria-hidden="true"></i></div>
          <h3>שקיפות</h3>
          <p>אתם מעודכנים באופן קבוע לגבי ההתקדמות, לוחות הזמנים והשלבים הבאים של התיק שלכם.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-bolt-lightning" aria-hidden="true"></i></div>
          <h3>תגובתיות</h3>
          <p>אנו עונים במהירות לשאלותיכם ומטפלים בבקשותיכם בחריצות וביעילות.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-user-group" aria-hidden="true"></i></div>
          <h3>מעקב אישי</h3>
          <p>יועץ ייעודי מכיר את התיק שלכם ותומך בכם בקשב רב מא' ועד ת'.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i></div>
          <h3>מומחיות חדה</h3>
          <p>תיהנו מהידע המעמיק והעדכני שלנו בחוק האזרחות המרוקאי.</p>
        </div>
        <div class="quality-item">
          <div class="quality-icon"><i class="fa-solid fa-shield-heart" aria-hidden="true"></i></div>
          <h3>סודיות</h3>
          <p>המידע האישי והתיק שלכם מטופלים בסודיות המחמירה ביותר.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">מוכנים להתחיל את המסע שלכם לקראת אזרחות מרוקאית?</h2>
      <div class="cta-buttons">
        <a href="#phase0" class="btn btn-light">התחילו עם ההערכה</a>
        <a href="contact.html" class="btn btn-outline-light">שאלו שאלה</a>
      </div>
    </div>
  </section>
  <CtaBanner lang={lang} />
</BaseLayout>
