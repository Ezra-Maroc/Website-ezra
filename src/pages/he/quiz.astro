---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'he' as const;
---

<BaseLayout
  lang={lang}
  title="חידון אינטראקטיבי על מרוקו | עזרא מרוק"
  description="בדקו את הידע שלכם על מרוקו עם החידון האינטראקטיבי והמהנה שלנו! גלו היסטוריה, תרבות, גיאוגרפיה ועוד."
  currentPage="quiz"
  pageCSS={['quiz-page']}
>
  <section class="page-banner quiz-page-banner">
    <div class="container">
      <h2>בדקו את הידע שלכם על הארץ שלכם</h2>
      <p>העמידו את הידע שלכם במבחן וגלו את הממלכה השריפית כמו מעולם!</p>
    </div>
  </section>

  <main id="main-content">
    <section class="section quiz-main-content">
      <div class="container">
        <div class="quiz-container">
          <div class="confetti-container" id="confetti-container"></div>
          <div class="content">
            <h1 id="quiz-title">החידון המלכותי של מרוקו</h1>
            <p class="subtitle" id="quiz-subtitle">בדקו את הידע שלכם על הממלכה השריפית!</p>

            <div id="theme-selection">
              <h2 id="theme-prompt" style="color: var(--primary-color); margin: 25px 0 15px; font-weight:600;">בחרו נושא כדי להתחיל את ההרפתקה:</h2>
              <div class="theme-selector" id="theme-selector"></div>
            </div>

            <div id="quiz-section" class="quiz-section">
              <div class="score-board">
                <div class="score"><span id="score-label">ניקוד: </span><span id="score">0</span>/<span id="total-questions-in-quiz">0</span></div>
                <div class="score-details"><span id="question-label">שאלה</span> <span id="current-q-num">1</span> <span id="of-label">מתוך</span> <span id="total-q-count">0</span></div>
                <div class="progress-bar">
                  <div class="progress-fill" id="progress"></div>
                </div>
              </div>
              <div class="theme-info" id="theme-info-display"></div>
              <div class="question-card">
                <div class="question" id="question"></div>
                <div class="answers" id="answers"></div>
                <div id="explanation-container" style="display:none;">
                  <p class="explanation" id="explanation-text"></p>
                </div>
              </div>
              <div style="margin-top:25px;">
                <button class="action-btn next-btn" id="next-btn" data-action="next" style="display: none;"><i class="fas fa-arrow-left" aria-hidden="true"></i> הבאה</button>
                <button class="action-btn restart-btn" data-action="restart"><i class="fas fa-sync-alt" aria-hidden="true"></i> נושא חדש</button>
              </div>
            </div>

            <div id="final-section" class="quiz-section">
              <div class="final-score-card">
                <h2 id="completion-title">החידון הסתיים! מרשים!</h2>
                <div class="score" id="final-score-text"></div>
                <div id="final-message"></div>
              </div>
              <div style="margin-top:25px;">
                <button class="action-btn restart-btn" data-action="retry"><i class="fas fa-redo" aria-hidden="true"></i> נסו שוב</button>
                <button class="action-btn next-btn" data-action="mixed"><i class="fas fa-dice" aria-hidden="true"></i> חידון מעורב</button>
              </div>
              <div class="quiz-cta" style="margin-top:30px; padding:20px; background:rgba(var(--primary-600-rgb,197,40,28),0.08); border-radius:10px; text-align:center;">
                <p style="font-size:1.05rem; margin-bottom:12px; font-weight:600; color:var(--dark-color,#333);">בדקו את הזכאות האמיתית שלכם לאזרחות מרוקאית!</p>
                <a href="contact.html" class="btn btn-primary" style="display:inline-block;">הערכה חינמית</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <section class="cta-section">
    <div class="container">
      <h2 class="cta-title">רוצים לדעת עוד על מרוקו?</h2>
      <div class="cta-buttons">
        <a href="advantages.html" class="btn btn-light">גלו את היתרונות</a>
        <a href="contact.html" class="btn btn-outline-light">צרו קשר</a>
      </div>
    </div>
  </section>

  <script is:inline>window.QUIZ_CONFIG = { lang: 'he', dataUrl: '/js/quiz-data-he.json', quizLength: 10 };</script>
  <script is:inline src="/js/quiz-engine.js" defer></script>
</BaseLayout>
