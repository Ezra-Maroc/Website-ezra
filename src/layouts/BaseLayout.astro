---
import type { Lang } from '../i18n/locales';
import { locales, isRTL } from '../i18n/locales';
import { ui } from '../i18n/translations';
import { getHreflangMap, getPageUrl } from '../i18n/nav';
import { getPrivacyUrl } from '../i18n/legal';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Fonts and icons served from the site itself (no Google Fonts, no cdnjs): nothing blocks
// rendering from another domain, and visitors' IP addresses are not sent to third parties.
import '@fortawesome/fontawesome-free/css/all.min.css';
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/poppins/300.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/heebo/400.css';
import '@fontsource/heebo/500.css';
import '@fontsource/heebo/600.css';
import '@fontsource/heebo/700.css';
import '@fontsource/assistant/300.css';
import '@fontsource/assistant/400.css';
import '@fontsource/assistant/500.css';
import '@fontsource/assistant/600.css';
import '@fontsource/cairo/300.css';
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/500.css';
import '@fontsource/cairo/600.css';
import '@fontsource/cairo/700.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  currentPage: string;
  pageCSS?: string[];
  jsonLD?: object | null;
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  currentPage,
  pageCSS = [],
  jsonLD = null,
  noindex = false,
} = Astro.props;

const config = locales[lang];
const t = ui[lang];
const hreflangMap = getHreflangMap(currentPage);
// Canonical derived from the same source as hreflang, menus and sitemap (nav.ts)
const canonicalUrl = `https://ezra-maroc.com${getPageUrl(currentPage, lang)}`;
const privacyUrl = getPrivacyUrl(lang);
const rtl = isRTL(lang);

// Determine which style.css to use
const langStyleMap: Record<string, string> = {
  fr: '/styles/style.css',
  en: '/styles/en/style.css',
  es: '/styles/style.css',  // ES uses root CSS
  he: '/styles/he/style.css',
  ar: '/styles/ara/style.css',
};
---

<!DOCTYPE html>
<html lang={config.htmlLang} dir={config.dir}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  {noindex && <meta name="robots" content="noindex, follow">}

  <!-- Hreflang -->
  {Object.entries(hreflangMap).map(([hreflang, url]) => (
    <link rel="alternate" hreflang={hreflang} href={url} />
  ))}

  <!-- Canonical -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://ezra-maroc.com/img/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={config.ogLocale} />
  <meta property="og:site_name" content="Ezra Maroc" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://ezra-maroc.com/img/og-image.png" />

  <!-- CSS Global -->
  <link rel="stylesheet" href={langStyleMap[lang] || '/styles/style.css'}>

  <!-- CSS Page-specific -->
  {pageCSS.map((css) => {
    // Determine the correct CSS path based on language
    let cssPath: string;
    if (css === 'contact' && lang !== 'fr' && lang !== 'es') {
      cssPath = `/styles/${lang === 'ar' ? 'ara' : lang}/${css}.css`;
    } else {
      cssPath = `/styles/${css}.css`;
    }
    return <link rel="stylesheet" href={cssPath} />;
  })}

  <!-- Quiz RTL CSS (only for quiz pages in HE/ARA) -->
  {currentPage === 'quiz' && rtl && <link rel="stylesheet" href="/styles/quiz-rtl.css">}

  <!-- Tarteaucitron CSS -->
  <link rel="stylesheet" href="/tarteaucitron/css/tarteaucitron.css">

  <!-- Skip link style -->
  <style>
    .skip-link {
      position: absolute;
      top: -40px;
      left: 0;
      background: #c5281c;
      color: #fff;
      padding: 8px 16px;
      z-index: 10000;
      transition: top 0.3s;
      font-size: 14px;
      text-decoration: none;
    }
    .skip-link:focus {
      top: 0;
    }
  </style>

  <!-- Logo preload -->
  <link rel="preload" as="image" href="/img/logo.webp" type="image/webp">

  <!-- LCP image preload: hero background of the home and contact pages -->
  {currentPage === 'home' && <link rel="preload" as="image" href="/img/drapeau-maroc.jpg" fetchpriority="high">}
  {currentPage === 'contact' && <link rel="preload" as="image" href="/img/market1.jpg" fetchpriority="high">}

  <!-- JSON-LD -->
  {jsonLD && <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />}
</head>
<body class:list={[config.bodyClass]}>
  <a href="#main-content" class="skip-link">{t.skipToContent}</a>

  <Header lang={lang} currentPage={currentPage} />

  <slot />

  <Footer lang={lang} />

  <!-- Language switcher handler -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      const langSelect = document.getElementById('lang-select');
      if (langSelect) {
        langSelect.addEventListener('change', function() {
          if (this.value) location = this.value;
        });
      }
      const cookieLinks = document.querySelectorAll('.cookie-settings-link');
      cookieLinks.forEach(function(link) {
        link.addEventListener('click', function(e) {
          e.preventDefault();
          if (window.tarteaucitron && tarteaucitron.userInterface && tarteaucitron.userInterface.openPanel) {
            tarteaucitron.userInterface.openPanel();
          }
        });
      });
    });
  </script>

  <!-- FAQ Accordion script (for faq + advantages pages) -->
  {(currentPage === 'faq' || currentPage === 'advantages') && (
    <script is:inline defer src="/js/faq-accordion.js"></script>
  )}

  <!-- Contact Form script (per-language) -->
  {currentPage === 'contact' && (
    <script is:inline defer src={`/js/contact-form${lang === 'fr' ? '' : '-' + lang}.js`}></script>
  )}

  <!-- Tarteaucitron (synchrone, PAS defer) -->
  <script is:inline type="text/javascript" src="/tarteaucitron/tarteaucitron.js"></script>
  <script is:inline src="/js/tarteaucitron-init.js" data-privacy-url={privacyUrl}></script>
</body>
</html>
